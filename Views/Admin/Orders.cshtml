@model FoodDeliveryApp.Models.ViewModels.AdminOrdersViewModel
@{
    ViewBag.Title = "Kitchen Orders Management";
    string activeTab = Model.ActiveTab.ToLowerInvariant();
    decimal todayRevenue = Model.AcceptedOrders.Sum(o => o.TotalAmount);
}

<!-- Top Header with Live Refresh Indicator -->
<div class="admin-header">
    <div>
        <h2 class="font-weight-bold m-0 d-flex align-items-center gap-2" style="font-size: 2rem; letter-spacing: -0.5px;">
            <i class="fa-solid fa-clipboard-list text-warning"></i>
            <span>Kitchen Order Management</span>
        </h2>
        <p class="text-muted small m-0 mt-1">
            Live order queue for <strong>@DateTime.Today.ToString("dddd, dd MMMM yyyy")</strong> &bull; Local Kitchen Hub Dispatch
        </p>
    </div>

    <!-- Live Polling Telemetry & Refresh Actions -->
    <div class="d-flex align-items-center gap-3">
        <div class="d-flex flex-column align-items-end">
            <div class="admin-ticker-badge" id="tickerBadge" title="Automatic live polling active">
                <span class="admin-ticker-dot"></span>
                <span>Polling &bull; <strong id="refreshCountdown">@Model.AutoRefreshSeconds</strong>s</span>
            </div>
            <div class="progress mt-1" style="height: 4px; width: 120px; border-radius: 2px; background: #e2e8f0;">
                <div id="refreshProgressBar" class="progress-bar bg-warning" role="progressbar" style="width: 100%; transition: width 1s linear;"></div>
            </div>
        </div>

        <a href="@Url.Action("Orders", "Admin", new { tab = activeTab })" class="btn btn-sm btn-outline-dark rounded-pill px-3 py-1 font-weight-bold shadow-sm" title="Refresh queue immediately">
            <i class="fa-solid fa-arrows-rotate me-1"></i> Refresh
        </a>

        <a href="@Url.Action("MenuItems", "Admin")" class="btn btn-sm btn-warning text-white rounded-pill px-3 py-1 font-weight-bold shadow-sm">
            <i class="fa-solid fa-layer-group me-1"></i> Inventory
        </a>
    </div>
</div>

<!-- Auto-Rejection Notification -->
@if (Model.AutoRejectedCount > 0)
{
    <div class="alert alert-warning alert-dismissible fade show shadow-sm rounded-4 py-2 px-3 small d-flex align-items-center justify-content-between mb-4" role="alert">
        <div class="d-flex align-items-center gap-2">
            <i class="fa-solid fa-triangle-exclamation text-warning fs-5"></i>
            <span>
                <strong>Automatic Rejection Notice:</strong> @Model.AutoRejectedCount pending order(s) exceeded the mandatory 5-minute kitchen response limit and were automatically transitioned to <strong>Rejected</strong>.
            </span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Executive KPI Summary Cards -->
<div class="admin-kpi-grid">
    <!-- 1. Pending Review -->
    <div class="admin-kpi-card">
        <div class="admin-kpi-icon pending">
            <i class="fa-solid fa-hourglass-half"></i>
        </div>
        <div>
            <div class="admin-kpi-val text-warning">@Model.PendingOrders.Count</div>
            <div class="admin-kpi-label">Pending Orders</div>
            <div class="text-muted small" style="font-size: 0.75rem;">Requires kitchen review</div>
        </div>
    </div>

    <!-- 2. Accepted Today -->
    <div class="admin-kpi-card">
        <div class="admin-kpi-icon accepted">
            <i class="fa-solid fa-fire-burner"></i>
        </div>
        <div>
            <div class="admin-kpi-val text-success">@Model.AcceptedOrders.Count</div>
            <div class="admin-kpi-label">Accepted Today</div>
            <div class="text-muted small" style="font-size: 0.75rem;">Cooking &amp; Dispatched</div>
        </div>
    </div>

    <!-- 3. Rejected / Expired -->
    <div class="admin-kpi-card">
        <div class="admin-kpi-icon rejected">
            <i class="fa-solid fa-ban"></i>
        </div>
        <div>
            <div class="admin-kpi-val text-danger">@Model.RejectedOrders.Count</div>
            <div class="admin-kpi-label">Declined / Expired</div>
            <div class="text-muted small" style="font-size: 0.75rem;">5-min timeout or manual</div>
        </div>
    </div>

    <!-- 4. Today's Gross Sales -->
    <div class="admin-kpi-card">
        <div class="admin-kpi-icon revenue">
            <i class="fa-solid fa-indian-rupee-sign"></i>
        </div>
        <div>
            <div class="admin-kpi-val text-dark">&#x20B9;@todayRevenue.ToString("N0")</div>
            <div class="admin-kpi-label">Today's Sales</div>
            <div class="text-muted small" style="font-size: 0.75rem;">From fulfilled orders</div>
        </div>
    </div>
</div>

<!-- Segmented Tab Navigation -->
<div class="admin-tabs">
    <a href="@Url.Action("Orders", "Admin", new { tab = "pending" })"
       class="admin-tab-btn @(activeTab == "pending" ? "active" : "")">
        <i class="fa-solid fa-hourglass-half"></i>
        <span>Pending Review</span>
        <span class="admin-tab-badge pending">@Model.PendingOrders.Count</span>
    </a>
    <a href="@Url.Action("Orders", "Admin", new { tab = "accepted" })"
       class="admin-tab-btn @(activeTab == "accepted" ? "active" : "")">
        <i class="fa-solid fa-circle-check"></i>
        <span>Accepted Orders</span>
        <span class="admin-tab-badge accepted">@Model.AcceptedOrders.Count</span>
    </a>
    <a href="@Url.Action("Orders", "Admin", new { tab = "rejected" })"
       class="admin-tab-btn @(activeTab == "rejected" ? "active" : "")">
        <i class="fa-solid fa-circle-xmark"></i>
        <span>Rejected Orders</span>
        <span class="admin-tab-badge rejected">@Model.RejectedOrders.Count</span>
    </a>
</div>

<!-- Tab Content Container Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    @if (activeTab == "pending")
    {
        <!-- Pending Orders Tab -->
        if (!Model.PendingOrders.Any())
        {
            <div class="admin-empty-state">
                <div class="admin-empty-icon" style="background: #fef3c7; color: #d97706;">
                    <i class="fa-solid fa-check-double"></i>
                </div>
                <h4 class="admin-empty-title">All Caught Up! No Pending Orders</h4>
                <p class="admin-empty-desc">
                    All customer orders placed today have been processed or none have arrived yet. New incoming orders will appear here automatically with live countdowns.
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a href="@Url.Action("Orders", "Admin", new { tab = "accepted" })" class="btn btn-outline-dark rounded-pill px-4 font-weight-bold">
                        View Accepted Orders (@Model.AcceptedOrders.Count)
                    </a>
                    <a href="@Url.Action("MenuItems", "Admin")" class="btn btn-warning text-white rounded-pill px-4 font-weight-bold">
                        Manage Menu Inventory &rarr;
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-order-table align-middle">
                    <thead>
                        <tr>
                            <th class="ps-4">Order #</th>
                            <th>Customer Details</th>
                            <th>Delivery Address</th>
                            <th>Dishes Ordered</th>
                            <th>Total (&#x20B9;)</th>
                            <th>Placed At</th>
                            <th class="text-center pe-4">Kitchen Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ord in Model.PendingOrders)
                        {
                            var timeAgoMinutes = (int)(DateTime.Now - ord.PlacedAt).TotalMinutes;
                            var isNearTimeout = timeAgoMinutes >= 4;

                            <tr class="@(isNearTimeout ? "expiring-row" : "")">
                                <td class="ps-4">
                                    <div class="font-monospace font-weight-bold text-dark">#@ord.OrderId</div>
                                    @if (isNearTimeout)
                                    {
                                        <span class="badge bg-danger text-white small mt-1 animate__animated animate__pulse animate__infinite">
                                            <i class="fa-solid fa-clock me-1"></i> Expiring Soon!
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="font-weight-bold text-dark">@ord.CustomerName</div>
                                    <div class="small text-muted"><i class="fa-solid fa-phone me-1"></i>+91 @ord.ContactPhone</div>
                                    <div class="small text-muted"><i class="fa-solid fa-envelope me-1"></i>@ord.CustomerEmail</div>
                                </td>
                                <td style="max-width: 240px;">
                                    <div class="small text-muted text-break">
                                        <i class="fa-solid fa-location-dot me-1 text-secondary"></i> @ord.DeliveryAddress
                                    </div>
                                    <div class="d-flex align-items-center gap-1 mt-1 flex-wrap">
                                        <span class="badge bg-light text-dark border small">@ord.PaymentMethod</span>
                                        @if (string.Equals(ord.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge-payment-paid"><i class="fa-solid fa-circle-check"></i> Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge-payment-pending"><i class="fa-solid fa-clock"></i> Collect COD</span>
                                        }
                                    </div>
                                </td>
                                <td style="max-width: 300px;">
                                    <div class="small font-weight-bold text-dark">@ord.ItemsSummary</div>
                                </td>
                                <td>
                                    <span class="font-weight-bold fs-6 text-dark">&#x20B9;@ord.TotalAmount.ToString("N2")</span>
                                </td>
                                <td>
                                    <div class="small font-weight-bold">@ord.PlacedAt.ToString("hh:mm tt")</div>
                                    <span class="badge bg-light text-muted border small">@timeAgoMinutes min ago</span>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <!-- Accept Action -->
                                        @using (Html.BeginForm("AcceptOrder", "Admin", FormMethod.Post, new { @class = "d-inline m-0" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="orderId" value="@ord.OrderId" />
                                            <input type="hidden" name="returnTab" value="pending" />
                                            <button type="submit" class="btn-admin-accept" title="Accept order and send to kitchen">
                                                <i class="fa-solid fa-check"></i> Accept
                                            </button>
                                        }

                                        <!-- Reject Action -->
                                        @using (Html.BeginForm("RejectOrder", "Admin", FormMethod.Post, new { @class = "d-inline m-0" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="orderId" value="@ord.OrderId" />
                                            <input type="hidden" name="returnTab" value="pending" />
                                            <button type="submit" class="btn-admin-reject" onclick="return confirm('Are you sure you want to reject Order #@ord.OrderId?');" title="Reject this order">
                                                <i class="fa-solid fa-xmark"></i> Reject
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (activeTab == "accepted")
    {
        <!-- Accepted Orders Tab -->
        if (!Model.AcceptedOrders.Any())
        {
            <div class="admin-empty-state">
                <div class="admin-empty-icon" style="background: #d1fae5; color: #059669;">
                    <i class="fa-solid fa-fire-burner"></i>
                </div>
                <h4 class="admin-empty-title">No Orders Accepted Yet Today</h4>
                <p class="admin-empty-desc">
                    Orders confirmed by kitchen staff will appear here with timestamps and prep dispatch tracking.
                </p>
                <a href="@Url.Action("Orders", "Admin", new { tab = "pending" })" class="btn btn-warning text-white rounded-pill px-4 font-weight-bold">
                    Check Pending Orders
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-order-table align-middle">
                    <thead>
                        <tr>
                            <th class="ps-4">Order #</th>
                            <th>Customer Details</th>
                            <th>Delivery Address</th>
                            <th>Dishes Ordered</th>
                            <th>Total (&#x20B9;)</th>
                            <th>Placed At</th>
                            <th>Accepted At</th>
                            <th class="pe-4">Current Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ord in Model.AcceptedOrders)
                        {
                            <tr>
                                <td class="ps-4 font-monospace font-weight-bold text-dark">#@ord.OrderId</td>
                                <td>
                                    <div class="font-weight-bold text-dark">@ord.CustomerName</div>
                                    <div class="small text-muted"><i class="fa-solid fa-phone me-1"></i>+91 @ord.ContactPhone</div>
                                </td>
                                <td style="max-width: 240px;">
                                    <div class="small text-muted text-break">@ord.DeliveryAddress</div>
                                    <div class="d-flex align-items-center gap-1 mt-1 flex-wrap">
                                        <span class="badge bg-light text-dark border small">@ord.PaymentMethod</span>
                                        @if (string.Equals(ord.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge-payment-paid"><i class="fa-solid fa-circle-check"></i> Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge-payment-pending"><i class="fa-solid fa-clock"></i> Collect COD</span>
                                        }
                                    </div>
                                </td>
                                <td style="max-width: 300px;">
                                    <div class="small font-weight-bold text-dark">@ord.ItemsSummary</div>
                                </td>
                                <td>
                                    <span class="font-weight-bold fs-6 text-dark">&#x20B9;@ord.TotalAmount.ToString("N2")</span>
                                </td>
                                <td class="small text-muted">@ord.PlacedAt.ToString("hh:mm tt")</td>
                                <td class="small text-muted">
                                    @(ord.UpdatedAt.HasValue ? ord.UpdatedAt.Value.ToString("hh:mm tt") : "N/A")
                                </td>
                                <td class="pe-4">
                                    <span class="badge-status accepted">
                                        <i class="fa-solid fa-kitchen-set me-1"></i> In Kitchen Prep
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (activeTab == "rejected")
    {
        <!-- Rejected Orders Tab -->
        if (!Model.RejectedOrders.Any())
        {
            <div class="admin-empty-state">
                <div class="admin-empty-icon" style="background: #fee2e2; color: #dc2626;">
                    <i class="fa-solid fa-ban"></i>
                </div>
                <h4 class="admin-empty-title">Zero Rejected Orders Today</h4>
                <p class="admin-empty-desc">
                    Great job! No orders have been declined or timed out today.
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-order-table align-middle">
                    <thead>
                        <tr>
                            <th class="ps-4">Order #</th>
                            <th>Customer Details</th>
                            <th>Delivery Address</th>
                            <th>Dishes Ordered</th>
                            <th>Total (&#x20B9;)</th>
                            <th>Placed At</th>
                            <th>Rejected At</th>
                            <th class="pe-4">Rejection Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ord in Model.RejectedOrders)
                        {
                            <tr>
                                <td class="ps-4 font-monospace font-weight-bold text-danger">#@ord.OrderId</td>
                                <td>
                                    <div class="font-weight-bold text-dark">@ord.CustomerName</div>
                                    <div class="small text-muted"><i class="fa-solid fa-phone me-1"></i>+91 @ord.ContactPhone</div>
                                </td>
                                <td style="max-width: 240px;">
                                    <div class="small text-muted text-break">@ord.DeliveryAddress</div>
                                </td>
                                <td style="max-width: 300px;">
                                    <div class="small text-muted">@ord.ItemsSummary</div>
                                </td>
                                <td>
                                    <span class="font-weight-bold fs-6 text-muted">&#x20B9;@ord.TotalAmount.ToString("N2")</span>
                                </td>
                                <td class="small text-muted">@ord.PlacedAt.ToString("hh:mm tt")</td>
                                <td class="small text-muted">
                                    @(ord.UpdatedAt.HasValue ? ord.UpdatedAt.Value.ToString("hh:mm tt") : "N/A")
                                </td>
                                <td class="pe-4">
                                    <span class="badge-status rejected">
                                        <i class="fa-solid fa-clock-rotate-left me-1"></i> Rejected / Timeout
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        (function () {
            var totalSeconds = @Model.AutoRefreshSeconds;
            var secondsRemaining = totalSeconds;
            var countdownEl = document.getElementById('refreshCountdown');
            var progressBarEl = document.getElementById('refreshProgressBar');
            var activeTab = '@activeTab';

            var interval = setInterval(function () {
                secondsRemaining--;
                if (countdownEl) {
                    countdownEl.textContent = Math.max(0, secondsRemaining);
                }
                if (progressBarEl && totalSeconds > 0) {
                    var pct = Math.max(0, (secondsRemaining / totalSeconds) * 100);
                    progressBarEl.style.width = pct + '%';
                }
                if (secondsRemaining <= 0) {
                    clearInterval(interval);
                    window.location.href = '@Url.Action("Orders", "Admin")?tab=' + encodeURIComponent(activeTab);
                }
            }, 1000);
        })();
    </script>
}
