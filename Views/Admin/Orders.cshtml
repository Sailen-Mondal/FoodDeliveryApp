@model FoodDeliveryApp.Models.ViewModels.AdminOrdersViewModel
@{
    ViewBag.Title = "Today's Orders Management Dashboard";
    string activeTab = Model.ActiveTab.ToLowerInvariant();
}

<div class="admin-header">
    <div>
        <h2 class="font-weight-bold m-0 d-flex align-items-center gap-2">
            <i class="fa-solid fa-clipboard-list text-warning"></i>
            <span>Today's Orders</span>
        </h2>
        <p class="text-muted small m-0">Live order queue for @DateTime.Today.ToString("dddd, dd MMMM yyyy")</p>
    </div>

    <!-- 60-Second Live Auto-Refresh Indicator with Visual Bar -->
    <div class="d-flex align-items-center gap-3">
        <div class="d-flex flex-column align-items-end">
            <div class="admin-ticker-badge" id="tickerBadge" title="Automatic live polling active">
                <span class="admin-ticker-dot"></span>
                <span>Refreshes in <strong id="refreshCountdown">@Model.AutoRefreshSeconds</strong>s</span>
            </div>
            <div class="progress mt-1 w-100" style="height: 4px; border-radius: 2px; background: #e2e8f0;">
                <div id="refreshProgressBar" class="progress-bar bg-warning" role="progressbar" style="width: 100%; transition: width 1s linear;" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
        </div>
        <a href="@Url.Action("Orders", "Admin", new { tab = activeTab })" class="btn btn-sm btn-outline-secondary rounded-pill px-3" title="Immediate poll">
            <i class="fa-solid fa-arrows-rotate me-1"></i> Refresh Now
        </a>
    </div>
    <noscript>
        <meta http-equiv="refresh" content="@Model.AutoRefreshSeconds;url=@Url.Action("Orders", "Admin", new { tab = activeTab })" />
    </noscript>
</div>

@if (Model.AutoRejectedCount > 0)
{
    <div class="alert alert-warning alert-dismissible fade show shadow-sm rounded-3 py-2 small" role="alert">
        <i class="fa-solid fa-triangle-exclamation me-2"></i>
        <strong>Auto-Rejection Notice:</strong> @Model.AutoRejectedCount pending order(s) exceeded the 5-minute response limit and were automatically transitioned to <strong>Rejected</strong>.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Tab Navigation -->
<div class="admin-tabs">
    <a href="@Url.Action("Orders", "Admin", new { tab = "pending" })"
       class="admin-tab-btn @(activeTab == "pending" ? "active" : "")">
        <i class="fa-solid fa-hourglass-half"></i>
        <span>Pending Orders</span>
        <span class="badge @(activeTab == "pending" ? "bg-white text-dark" : "bg-warning text-dark")">@Model.PendingOrders.Count</span>
    </a>
    <a href="@Url.Action("Orders", "Admin", new { tab = "accepted" })"
       class="admin-tab-btn @(activeTab == "accepted" ? "active" : "")">
        <i class="fa-solid fa-circle-check"></i>
        <span>Accepted Orders</span>
        <span class="badge @(activeTab == "accepted" ? "bg-white text-success" : "bg-success text-white")">@Model.AcceptedOrders.Count</span>
    </a>
    <a href="@Url.Action("Orders", "Admin", new { tab = "rejected" })"
       class="admin-tab-btn @(activeTab == "rejected" ? "active" : "")">
        <i class="fa-solid fa-circle-xmark"></i>
        <span>Rejected Orders</span>
        <span class="badge @(activeTab == "rejected" ? "bg-white text-danger" : "bg-danger text-white")">@Model.RejectedOrders.Count</span>
    </a>
</div>

<!-- Tab Content Container -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white mb-4">
    @if (activeTab == "pending")
    {
        <!-- 1. Pending Orders Tab (Page 10) -->
        if (!Model.PendingOrders.Any())
        {
            <div class="text-center py-5">
                <i class="fa-solid fa-check-double fs-1 text-muted opacity-50 mb-3"></i>
                <h5 class="text-secondary">No pending orders waiting for review</h5>
                <p class="text-muted small">All today's orders have been processed or none have been submitted yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-order-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Order #</th>
                            <th>Customer Details</th>
                            <th>Delivery Destination</th>
                            <th>Dishes Ordered</th>
                            <th>Total (&#x20B9;)</th>
                            <th>Placed At</th>
                            <th class="text-center pe-4">Kitchen Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ord in Model.PendingOrders)
                        {
                            var timeAgoMinutes = (int)(DateTime.Now - ord.PlacedAt).TotalMinutes;
                            var isNearTimeout = timeAgoMinutes >= 4;

                            <tr class="@(isNearTimeout ? "table-warning" : "")">
                                <td class="ps-4 font-monospace font-weight-bold">
                                    #@ord.OrderId
                                    @if (isNearTimeout)
                                    {
                                        <div class="badge bg-danger small text-white mt-1 d-block">Expiring Soon!</div>
                                    }
                                </td>
                                <td>
                                    <div class="font-weight-bold text-dark">@ord.CustomerName</div>
                                    <div class="small text-muted"><i class="fa-solid fa-envelope me-1"></i>@ord.CustomerEmail</div>
                                    <div class="small text-muted"><i class="fa-solid fa-phone me-1"></i>+91 @ord.ContactPhone</div>
                                </td>
                                <td style="max-width: 220px;">
                                    <div class="small text-muted text-break">
                                        <i class="fa-solid fa-location-dot me-1 text-secondary"></i> @ord.DeliveryAddress
                                    </div>
                                    <span class="badge bg-light text-dark border small mt-1">@ord.PaymentMethod</span>
                                </td>
                                <td style="max-width: 320px;">
                                    <div class="small font-weight-bold">@ord.ItemsSummary</div>
                                </td>
                                <td class="font-weight-bold fs-6 text-dark">
                                    &#x20B9;@ord.TotalAmount.ToString("N2")
                                </td>
                                <td class="small text-muted">
                                    <div>@ord.PlacedAt.ToString("hh:mm:ss tt")</div>
                                    <div class="badge bg-light text-secondary border small">@timeAgoMinutes min ago</div>
                                </td>
                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <!-- Accept Action -->
                                        @using (Html.BeginForm("AcceptOrder", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="orderId" value="@ord.OrderId" />
                                            <input type="hidden" name="returnTab" value="pending" />
                                            <button type="submit" class="btn-admin-accept" title="Accept and start preparation">
                                                <i class="fa-solid fa-check me-1"></i> Accept
                                            </button>
                                        }

                                        <!-- Reject Action -->
                                        @using (Html.BeginForm("RejectOrder", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="orderId" value="@ord.OrderId" />
                                            <input type="hidden" name="returnTab" value="pending" />
                                            <button type="submit" class="btn-admin-reject" onclick="return confirm('Are you sure you want to reject Order #@ord.OrderId?');" title="Reject this order">
                                                <i class="fa-solid fa-xmark me-1"></i> Reject
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (activeTab == "accepted")
    {
        <!-- 2. Accepted Orders Tab (Page 11) -->
        if (!Model.AcceptedOrders.Any())
        {
            <div class="text-center py-5">
                <i class="fa-solid fa-clipboard-check fs-1 text-muted opacity-50 mb-3"></i>
                <h5 class="text-secondary">No orders accepted yet today</h5>
                <p class="text-muted small">Accepted orders currently in preparation will appear here.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-order-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Order #</th>
                            <th>Customer Details</th>
                            <th>Delivery Address</th>
                            <th>Dishes Ordered</th>
                            <th>Total (&#x20B9;)</th>
                            <th>Placed At</th>
                            <th>Accepted At</th>
                            <th class="pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ord in Model.AcceptedOrders)
                        {
                            <tr>
                                <td class="ps-4 font-monospace font-weight-bold">#@ord.OrderId</td>
                                <td>
                                    <div class="font-weight-bold text-dark">@ord.CustomerName</div>
                                    <div class="small text-muted"><i class="fa-solid fa-phone me-1"></i>+91 @ord.ContactPhone</div>
                                </td>
                                <td style="max-width: 240px;">
                                    <div class="small text-muted text-break">@ord.DeliveryAddress</div>
                                </td>
                                <td style="max-width: 320px;">
                                    <div class="small font-weight-bold">@ord.ItemsSummary</div>
                                </td>
                                <td class="font-weight-bold fs-6">
                                    &#x20B9;@ord.TotalAmount.ToString("N2")
                                </td>
                                <td class="small text-muted">@ord.PlacedAt.ToString("hh:mm tt")</td>
                                <td class="small text-muted">
                                    @(ord.UpdatedAt.HasValue ? ord.UpdatedAt.Value.ToString("hh:mm tt") : "N/A")
                                </td>
                                <td class="pe-4">
                                    <span class="badge-status accepted">
                                        <i class="fa-solid fa-kitchen-set me-1"></i> In Prep / Accepted
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (activeTab == "rejected")
    {
        <!-- 3. Rejected Orders Tab (Page 12) -->
        if (!Model.RejectedOrders.Any())
        {
            <div class="text-center py-5">
                <i class="fa-solid fa-shield-cat fs-1 text-muted opacity-50 mb-3"></i>
                <h5 class="text-secondary">No rejected orders for today</h5>
                <p class="text-muted small">Orders rejected manually or automatically timed out will appear here.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table admin-order-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Order #</th>
                            <th>Customer Details</th>
                            <th>Delivery Address</th>
                            <th>Dishes Ordered</th>
                            <th>Total (&#x20B9;)</th>
                            <th>Placed At</th>
                            <th>Rejected At</th>
                            <th class="pe-4">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ord in Model.RejectedOrders)
                        {
                            <tr>
                                <td class="ps-4 font-monospace font-weight-bold text-danger">#@ord.OrderId</td>
                                <td>
                                    <div class="font-weight-bold text-dark">@ord.CustomerName</div>
                                    <div class="small text-muted"><i class="fa-solid fa-phone me-1"></i>+91 @ord.ContactPhone</div>
                                </td>
                                <td style="max-width: 240px;">
                                    <div class="small text-muted text-break">@ord.DeliveryAddress</div>
                                </td>
                                <td style="max-width: 320px;">
                                    <div class="small text-muted">@ord.ItemsSummary</div>
                                </td>
                                <td class="font-weight-bold fs-6 text-muted">
                                    &#x20B9;@ord.TotalAmount.ToString("N2")
                                </td>
                                <td class="small text-muted">@ord.PlacedAt.ToString("hh:mm tt")</td>
                                <td class="small text-muted">
                                    @(ord.UpdatedAt.HasValue ? ord.UpdatedAt.Value.ToString("hh:mm tt") : "N/A")
                                </td>
                                <td class="pe-4">
                                    <span class="badge-status rejected">
                                        <i class="fa-solid fa-ban me-1"></i> Rejected
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        (function () {
            var totalSeconds = @Model.AutoRefreshSeconds;
            var secondsRemaining = totalSeconds;
            var countdownEl = document.getElementById('refreshCountdown');
            var progressBarEl = document.getElementById('refreshProgressBar');
            var activeTab = '@activeTab';

            var interval = setInterval(function () {
                secondsRemaining--;
                if (countdownEl) {
                    countdownEl.textContent = Math.max(0, secondsRemaining);
                }
                if (progressBarEl && totalSeconds > 0) {
                    var pct = Math.max(0, (secondsRemaining / totalSeconds) * 100);
                    progressBarEl.style.width = pct + '%';
                }
                if (secondsRemaining <= 0) {
                    clearInterval(interval);
                    // Seamless auto-refresh preserving the active tab selection
                    window.location.href = '@Url.Action("Orders", "Admin")?tab=' + encodeURIComponent(activeTab);
                }
            }, 1000);
        })();
    </script>
}
