<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Foodly Kitchen</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body>
    <!-- Foodly Sticky Top Navbar -->
    <nav class="foodly-navbar">
        <div class="container d-flex align-items-center justify-content-between">
            <!-- Left: Brand Logo -->
            <a href="@Url.Action("Index", "Home")" class="foodly-brand" title="Foodly Kitchen">
                <img src="@Url.Content("~/Content/images/foodly-logo.svg")" alt="Foodly Kitchen Logo" class="foodly-nav-logo" />
            </a>

            <!-- Center: Navigation Links -->
            <div class="d-none d-lg-flex align-items-center gap-1">
                <a href="@Url.Action("Index", "Home")" class="foodly-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">Home</a>
                <a href="@Url.Action("Index", "Menu")" class="foodly-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Menu" ? "active" : "")">Menu</a>
                <a href="@Url.Action("About", "Home")" class="foodly-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")">About</a>
                <a href="@Url.Action("Contact", "Home")" class="foodly-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")">Contact</a>
                @if (Request.IsAuthenticated && !User.IsInRole("Admin"))
                {
                    <a href="@Url.Action("History", "Order")" class="foodly-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Order" ? "active" : "")">My Orders</a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a href="@Url.Action("Orders", "Admin")" class="foodly-nav-link text-warning @(ViewContext.RouteData.Values["action"]?.ToString() == "Orders" ? "active" : "")">
                        <i class="fa-solid fa-clipboard-list me-1"></i> Orders
                    </a>
                    <a href="@Url.Action("MenuItems", "Admin")" class="foodly-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MenuItems" ? "active" : "")">
                        <i class="fa-solid fa-utensils me-1"></i> Inventory
                    </a>
                }
            </div>

            <!-- Right: Action Icons & Primary CTA -->
            <div class="d-flex align-items-center gap-2">
                <!-- Quick Search Icon Link -->
                <a href="@Url.Action("Index", "Menu")" class="foodly-icon-btn d-none d-sm-inline-flex" title="Search Dishes">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </a>

                <!-- Account / Authentication -->
                @if (Request.IsAuthenticated)
                {
                    <div class="dropdown">
                        <button class="foodly-icon-btn dropdown-toggle border-0" type="button" id="userMenuBtn" data-bs-toggle="dropdown" aria-expanded="false" title="@User.Identity.Name">
                            <i class="fa-solid fa-user text-warning"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenuBtn">
                            <li class="px-3 py-1 text-muted small border-bottom mb-1 font-weight-bold">
                                Hi, @User.Identity.Name
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li><a class="dropdown-item" href="@Url.Action("Orders", "Admin")"><i class="fa-solid fa-clipboard-list me-2"></i> Orders Dashboard</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("MenuItems", "Admin")"><i class="fa-solid fa-utensils me-2"></i> Menu Items</a></li>
                            }
                            else
                            {
                                <li><a class="dropdown-item" href="@Url.Action("History", "Order")"><i class="fa-solid fa-clock-rotate-left me-2"></i> My Order History</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                @using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "d-inline m-0 p-0" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item text-danger d-flex align-items-center">
                                        <i class="fa-solid fa-right-from-bracket me-2"></i> Sign Out
                                    </button>
                                }
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <div class="dropdown">
                        <button class="foodly-icon-btn dropdown-toggle border-0" type="button" id="authMenuBtn" data-bs-toggle="dropdown" aria-expanded="false" title="Account">
                            <i class="fa-regular fa-user"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="authMenuBtn">
                            <li><a class="dropdown-item" href="@Url.Action("Login", "Account")"><i class="fa-solid fa-arrow-right-to-bracket me-2"></i> Customer Sign In</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Register", "Account")"><i class="fa-solid fa-user-plus me-2"></i> Create Account</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-secondary small" href="@Url.Action("AdminLogin", "Account")"><i class="fa-solid fa-lock me-2"></i> Admin Portal</a></li>
                        </ul>
                    </div>
                }

                <!-- Cart Button with Counter Badge -->
                @if (!User.IsInRole("Admin"))
                {
                    <button type="button" class="foodly-icon-btn" id="openCartDrawerBtn" title="Shopping Cart">
                        <i class="fa-solid fa-bag-shopping"></i>
                        <span class="foodly-icon-badge" id="cartCountBadge">0</span>
                    </button>
                }

                <!-- Primary Amber "Order Now" Pill Button -->
                <a href="@Url.Action("Index", "Menu")" class="btn-foodly-order-now">
                    <span>Order Now</span>
                </a>
            </div>
        </div>
    </nav>

    <!-- Global Flash Alerts -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3" role="alert">
                <i class="fa-solid fa-circle-exclamation me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Content Body -->
    <main class="container my-4">
        @RenderBody()
    </main>

    <!-- Interactive Cart Drawer (<dialog>) -->
    <dialog id="cartDrawer" aria-label="Shopping Cart">
        <div class="drawer-header">
            <h5>
                <i class="fa-solid fa-bag-shopping text-warning"></i>
                <span>My Food Basket</span>
            </h5>
            <button type="button" class="drawer-close-btn" id="closeCartDrawerBtn" aria-label="Close cart">&times;</button>
        </div>
        <div class="drawer-body" id="cartDrawerBody">
            <div class="text-center py-5 text-muted" id="cartEmptyPlaceholder">
                <i class="fa-solid fa-utensils fs-1 mb-3 text-secondary opacity-50"></i>
                <h6>Your basket is hungry!</h6>
                <p class="small">Add delicious dishes from our menu to begin your feast.</p>
                <a href="@Url.Action("Index", "Menu")" class="btn btn-sm btn-outline-warning rounded-pill px-3 mt-2" onclick="FoodlyCart.close()">Browse Menu</a>
            </div>
            <div id="cartItemList" class="d-none"></div>
        </div>
        <div class="drawer-footer d-none" id="cartDrawerFooter">
            <div class="drawer-bill-row">
                <span>Items Subtotal</span>
                <span id="cartDrawerSubtotal">&#x20B9;0.00</span>
            </div>
            <div class="drawer-bill-row">
                <span>Delivery Charge</span>
                <span id="cartDrawerDeliveryFee">&#x20B9;0.00</span>
            </div>
            <div class="drawer-bill-total">
                <span>To Pay</span>
                <span id="cartDrawerTotal" class="text-warning">&#x20B9;0.00</span>
            </div>
            <a href="@Url.Action("Checkout", "Order")" class="btn-foodly-checkout">
                Proceed to Checkout <i class="fa-solid fa-arrow-right ms-2"></i>
            </a>
        </div>
    </dialog>

    <!-- Sleek Toast Notification -->
    <div id="foodlyToast" class="foodly-toast">
        <i class="fa-solid fa-circle-check"></i>
        <span id="foodlyToastMsg">Added to your basket!</span>
    </div>

    <!-- Footer Matching Reference Specifications -->
    <footer class="foodly-footer">
        <div class="container">
            <div class="row g-4 mb-4">
                <!-- Col 1: Brand & Tagline -->
                <div class="col-lg-4 col-md-6">
                    <div class="mb-3">
                        <img src="@Url.Content("~/Content/images/foodly-logo.svg")" alt="Foodly Kitchen" class="foodly-footer-logo" />
                    </div>
                    <p class="text-muted small pe-lg-4">
                        Fresh food, fast delivery, every single day. Savor authentic Indian biryanis, slow-simmered curries, artisan pizzas, and sizzling street delicacies delivered steaming hot.
                    </p>
                </div>

                <!-- Col 2: Company -->
                <div class="col-lg-2 col-md-6 col-6">
                    <h6>Company</h6>
                    <a href="@Url.Action("About", "Home")" class="foodly-footer-link">About Us</a>
                    <a href="#" class="foodly-footer-link">Careers</a>
                    <a href="#" class="foodly-footer-link">Blog</a>
                    <a href="#" class="foodly-footer-link">Press</a>
                </div>

                <!-- Col 3: Explore -->
                <div class="col-lg-2 col-md-6 col-6">
                    <h6>Explore</h6>
                    <a href="@Url.Action("Index", "Menu")" class="foodly-footer-link">Full Menu</a>
                    <a href="@Url.Action("Index", "Menu", new { isVeg = true })" class="foodly-footer-link">Pure Veg Dishes</a>
                    <a href="@Url.Action("Index", "Menu", new { isVeg = false })" class="foodly-footer-link">Non-Veg Specials</a>
                    <a href="@Url.Action("Index", "Menu", new { sortBy = "popular" })" class="foodly-footer-link">Chef's Bestsellers</a>
                </div>

                <!-- Col 4: Support -->
                <div class="col-lg-2 col-md-6 col-6">
                    <h6>Support</h6>
                    <a href="@Url.Action("Contact", "Home")" class="foodly-footer-link">Help Center</a>
                    <a href="@Url.Action("History", "Order")" class="foodly-footer-link">Track Order</a>
                    <a href="#" class="foodly-footer-link">Returns &amp; Refunds</a>
                    <a href="@Url.Action("Contact", "Home")" class="foodly-footer-link">Contact Support</a>
                </div>

                <!-- Col 5: Legal -->
                <div class="col-lg-2 col-md-6 col-6">
                    <h6>Legal</h6>
                    <a href="#" class="foodly-footer-link">Privacy Policy</a>
                    <a href="#" class="foodly-footer-link">Terms of Service</a>
                    <a href="#" class="foodly-footer-link">FSSAI Compliance</a>
                    <a href="#" class="foodly-footer-link">Cookie Settings</a>
                </div>
            </div>

            <div class="pt-4 border-top d-flex flex-wrap align-items-center justify-content-between gap-3 text-muted small">
                <div>
                    &copy; 2026 Foodly Kitchen. Crafted with passion by Sailen Mondal. All rights reserved.
                </div>
                <div class="d-flex align-items-center gap-2">
                    <a href="#" class="foodly-social-icon" title="Instagram"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" class="foodly-social-icon" title="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#" class="foodly-social-icon" title="Twitter"><i class="fa-brands fa-twitter"></i></a>
                </div>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)

    <!-- Foodly Global Cart & Notification Script -->
    <script>
        (function () {
            var cartDialog = document.getElementById('cartDrawer');
            var openBtn = document.getElementById('openCartDrawerBtn');
            var closeBtn = document.getElementById('closeCartDrawerBtn');
            var toastEl = document.getElementById('foodlyToast');
            var toastMsg = document.getElementById('foodlyToastMsg');
            var toastTimer = null;

            function showToast(msg) {
                if (toastEl) {
                    if (toastMsg) toastMsg.textContent = msg || 'Added to your basket!';
                    toastEl.classList.add('show');
                    if (toastTimer) clearTimeout(toastTimer);
                    toastTimer = setTimeout(function () {
                        toastEl.classList.remove('show');
                    }, 2500);
                }
            }

            function openDrawer() {
                if (cartDialog && typeof cartDialog.showModal === 'function') {
                    if (!cartDialog.open) {
                        cartDialog.showModal();
                        refreshDrawer();
                    }
                }
            }

            function closeDrawer() {
                if (cartDialog && cartDialog.open) {
                    cartDialog.close();
                }
            }

            if (openBtn) openBtn.addEventListener('click', openDrawer);
            if (closeBtn) closeBtn.addEventListener('click', closeDrawer);

            if (cartDialog) {
                cartDialog.addEventListener('click', function (e) {
                    var rect = cartDialog.getBoundingClientRect();
                    var isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
                        rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
                    if (!isInDialog) {
                        closeDrawer();
                    }
                });
            }

            function escapeHtml(str) {
                if (!str) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            function renderCartItems(data) {
                var badge = document.getElementById('cartCountBadge');
                if (badge) badge.textContent = data.itemCount || 0;

                var emptyPlaceholder = document.getElementById('cartEmptyPlaceholder');
                var itemList = document.getElementById('cartItemList');
                var footer = document.getElementById('cartDrawerFooter');

                if (!data.items || data.items.length === 0) {
                    if (emptyPlaceholder) emptyPlaceholder.classList.remove('d-none');
                    if (itemList) itemList.classList.add('d-none');
                    if (footer) footer.classList.add('d-none');
                    return;
                }

                if (emptyPlaceholder) emptyPlaceholder.classList.add('d-none');
                if (itemList) {
                    itemList.classList.remove('d-none');
                    var html = '';
                    data.items.forEach(function (item) {
                        var vegClass = item.IsVeg ? 'veg' : 'nonveg';
                        var safeName = escapeHtml(item.Name);
                        var safeImg = escapeHtml(item.ImageUrl);
                        html += '<div class="drawer-item">' +
                            '<img src="' + safeImg + '" class="drawer-item-img" alt="' + safeName + '" onerror="this.src=\'/Content/images/dishes/dish-1.jpg\'" />' +
                            '<div class="drawer-item-info">' +
                            '<div class="d-flex align-items-center gap-1 mb-1">' +
                            '<span class="diet-badge ' + vegClass + '"></span>' +
                            '<span class="drawer-item-title">' + safeName + '</span>' +
                            '</div>' +
                            '<div class="drawer-item-price">&#x20B9;' + Number(item.Price).toFixed(2) + '</div>' +
                            '</div>' +
                            '<div class="drawer-qty-control">' +
                            '<button type="button" class="drawer-qty-btn" onclick="FoodlyCart.update(' + item.ItemId + ', -1)">-</button>' +
                            '<span class="drawer-qty-val">' + item.Quantity + '</span>' +
                            '<button type="button" class="drawer-qty-btn" onclick="FoodlyCart.update(' + item.ItemId + ', 1)">+</button>' +
                            '</div>' +
                            '</div>';
                    });
                    itemList.innerHTML = html;
                }

                if (footer) {
                    footer.classList.remove('d-none');
                    var subtotalEl = document.getElementById('cartDrawerSubtotal');
                    var feeEl = document.getElementById('cartDrawerDeliveryFee');
                    var totalEl = document.getElementById('cartDrawerTotal');

                    if (subtotalEl) subtotalEl.innerHTML = '&#x20B9;' + Number(data.subTotal).toFixed(2);
                    if (feeEl) {
                        feeEl.innerHTML = data.deliveryFee > 0 ? '&#x20B9;' + Number(data.deliveryFee).toFixed(2) : '<span class="text-success font-weight-bold">FREE</span>';
                    }
                    if (totalEl) totalEl.innerHTML = '&#x20B9;' + Number(data.total).toFixed(2);
                }
            }

            function refreshDrawer() {
                $.ajax({
                    url: '@Url.Action("GetSummary", "Cart")',
                    type: 'GET',
                    success: function (res) {
                        if (res && res.success) {
                            renderCartItems(res);
                        }
                    }
                });
            }

            window.FoodlyCart = {
                open: openDrawer,
                close: closeDrawer,
                refresh: refreshDrawer,
                showToast: showToast,
                add: function (itemId, quantity, silent) {
                    $.ajax({
                        url: '@Url.Action("Add", "Cart")',
                        type: 'POST',
                        data: { itemId: itemId, quantity: quantity || 1 },
                        success: function (res) {
                            if (res && res.success) {
                                renderCartItems(res);
                                showToast('Added to your basket!');
                                if (!silent) {
                                    // Subtle pulse on cart badge
                                    var badge = document.getElementById('cartCountBadge');
                                    if (badge) {
                                        badge.style.transform = 'scale(1.4)';
                                        setTimeout(function () { badge.style.transform = 'scale(1)'; }, 200);
                                    }
                                }
                            } else {
                                alert(res.message || 'Unable to add dish to cart.');
                            }
                        },
                        error: function () {
                            alert('An error occurred while adding to cart.');
                        }
                    });
                },
                update: function (itemId, delta) {
                    $.ajax({
                        url: '@Url.Action("UpdateQuantity", "Cart")',
                        type: 'POST',
                        data: { itemId: itemId, delta: delta },
                        success: function (res) {
                            if (res && res.success) {
                                renderCartItems(res);
                            }
                        }
                    });
                }
            };

            // Global event handler for circular add buttons
            $(document).ready(function () {
                refreshDrawer();

                $(document).on('click', '.btn-circular-add, .btn-foodly-add', function (e) {
                    e.preventDefault();
                    var itemId = $(this).data('item-id');
                    if (itemId) {
                        FoodlyCart.add(itemId, 1, false);
                    }
                });

                // Toggle heart favorite icon
                $(document).on('click', '.foodly-card-fav', function (e) {
                    e.preventDefault();
                    var icon = $(this).find('i');
                    if (icon.hasClass('fa-regular')) {
                        icon.removeClass('fa-regular fa-heart').addClass('fa-solid fa-heart');
                        $(this).addClass('active');
                        FoodlyCart.showToast('Saved to your favorites!');
                    } else {
                        icon.removeClass('fa-solid fa-heart').addClass('fa-regular fa-heart');
                        $(this).removeClass('active');
                    }
                });
            });
        })();
    </script>
</body>
</html>
