@model FoodDeliveryApp.Models.ViewModels.OrderHistoryItemViewModel
@{
    ViewBag.Title = "Order Placed Successfully!";
    int orderId = Model?.OrderId ?? (ViewBag.OrderId != null ? (int)ViewBag.OrderId : 0);
    bool isPaid = string.Equals(Model?.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase);
}

<div class="row justify-content-center my-4">
    <div class="col-lg-7 col-md-9 text-center">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <!-- Animated Success Icon -->
            <div class="foodly-brand-icon mx-auto mb-3" style="width: 76px; height: 76px; font-size: 2.2rem; background: linear-gradient(135deg, #16a34a, #15803d); box-shadow: 0 8px 20px rgba(22, 163, 74, 0.28);">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            
            <h2 class="font-weight-bold text-success mb-1">Order Confirmed!</h2>
            <div class="text-muted mb-4">
                Order Reference: <span class="badge bg-dark font-monospace fs-6 px-3 py-2 rounded-pill">#@orderId</span>
            </div>

            <!-- Payment & Security Summary Banner -->
            <div class="card bg-light border-0 rounded-4 p-3 mb-4 text-start">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pb-2 border-bottom">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fs-5 text-warning"><i class="fa-solid fa-receipt"></i></span>
                        <span class="font-weight-bold text-dark">Payment Status:</span>
                        @if (isPaid)
                        {
                            <span class="badge-payment-paid">
                                <i class="fa-solid fa-circle-check"></i> Paid Online (Verified)
                            </span>
                        }
                        else
                        {
                            <span class="badge-payment-pending">
                                <i class="fa-solid fa-clock"></i> Cash on Delivery (Due at Doorstep)
                            </span>
                        }
                    </div>
                    @if (Model != null && Model.TotalAmount > 0)
                    {
                        <div class="font-weight-bold fs-5 text-dark">
                            &#x20B9;@Model.TotalAmount.ToString("N2")
                        </div>
                    }
                </div>

                <div class="row g-2 pt-2 small text-secondary">
                    @if (!string.IsNullOrWhiteSpace(Model?.PaymentTransactionId))
                    {
                        <div class="col-sm-6">
                            <span class="text-muted">Transaction ID:</span>
                            <span class="font-monospace text-dark font-weight-bold">@Model.PaymentTransactionId</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model?.PaymentMethod))
                    {
                        <div class="col-sm-6">
                            <span class="text-muted">Method:</span>
                            <span class="text-dark font-weight-bold">@Model.PaymentMethod</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model?.MaskedPaymentDetails))
                    {
                        <div class="col-12">
                            <span class="text-muted">Channel / Account:</span>
                            <span class="text-dark font-weight-bold">@Model.MaskedPaymentDetails</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Live Kitchen & Delivery Tracker Card -->
            <div class="card border border-warning bg-white rounded-4 p-3 mb-4 text-start" style="box-shadow: 0 4px 14px rgba(245, 166, 35, 0.08);">
                <div class="d-flex align-items-center gap-3">
                    <div class="fs-2 text-warning"><i class="fa-solid fa-motorcycle"></i></div>
                    <div>
                        <div class="font-weight-bold text-dark">Estimated Delivery: 30 &ndash; 40 minutes</div>
                        <div class="text-muted small">
                            Our chefs have received your order ticket and are firing up fresh regional ingredients.
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model?.DeliveryAddress))
                {
                    <div class="mt-3 pt-2 border-top small text-muted">
                        <i class="fa-solid fa-location-dot text-warning me-1"></i> Delivering to: <strong class="text-dark">@Model.DeliveryAddress</strong>
                    </div>
                }
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a href="@Url.Action("History", "Order")" class="btn btn-warning text-white rounded-pill px-4 py-2 font-weight-bold shadow-sm">
                    <i class="fa-solid fa-clock-rotate-left me-2"></i> View in Order History
                </a>
                <a href="@Url.Action("Index", "Menu")" class="btn btn-outline-dark rounded-pill px-4 py-2 font-weight-bold">
                    Order More Dishes
                </a>
            </div>
        </div>
    </div>
</div>
