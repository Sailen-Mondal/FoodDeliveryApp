@model FoodDeliveryApp.Models.ViewModels.OrderPlacementViewModel
@{
    ViewBag.Title = "Secure Checkout & Payment";
}

<div class="row g-4 my-2">
    <!-- Left Column: Delivery & Payment Methods -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4 bg-white mb-4 overflow-hidden">
            <div class="p-4">
                <!-- Step 1: Delivery Destination -->
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h4 class="font-weight-bold m-0 d-flex align-items-center gap-2">
                        <span class="badge rounded-circle bg-warning text-white d-inline-flex align-items-center justify-content-center" style="width: 30px; height: 30px; font-size: 0.85rem;">1</span>
                        <span>Delivery Destination</span>
                    </h4>
                    <span class="text-success small font-weight-bold"><i class="fa-solid fa-circle-check me-1"></i> Fast Delivery</span>
                </div>

                @using (Html.BeginForm("PlaceOrder", "Order", FormMethod.Post, new { id = "checkoutForm" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })
                    <input type="hidden" name="IdempotencyToken" value="@Model.IdempotencyToken" />
                    <input type="hidden" name="PaymentMethod" id="selectedPaymentMethod" value="@Model.PaymentMethod" />
                    <input type="hidden" name="UpiApp" id="selectedUpiApp" value="@Model.UpiApp" />
                    <input type="hidden" name="CardNetwork" id="selectedCardNetwork" value="@Model.CardNetwork" />
                    <input type="hidden" name="SelectedBank" id="selectedBankInput" value="@Model.SelectedBank" />

                    <div class="mb-3">
                        @Html.LabelFor(m => m.DeliveryAddress, new { @class = "form-label font-weight-bold small text-secondary" })
                        @Html.TextAreaFor(m => m.DeliveryAddress, new { @class = "form-control rounded-3", rows = "2", placeholder = "Complete street address, flat/building, landmark, city & PIN" })
                        @Html.ValidationMessageFor(m => m.DeliveryAddress, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4">
                        @Html.LabelFor(m => m.ContactPhone, new { @class = "form-label font-weight-bold small text-secondary" })
                        <div class="input-group">
                            <span class="input-group-text bg-light font-weight-bold text-secondary">+91</span>
                            @Html.TextBoxFor(m => m.ContactPhone, new { @class = "form-control rounded-end-3", placeholder = "10-digit mobile number", maxlength = "10" })
                        </div>
                        @Html.ValidationMessageFor(m => m.ContactPhone, "", new { @class = "text-danger small" })
                    </div>

                    <!-- Step 2: Payment Selector -->
                    <div class="d-flex align-items-center justify-content-between pt-3 border-top mb-3">
                        <h4 class="font-weight-bold m-0 d-flex align-items-center gap-2">
                            <span class="badge rounded-circle bg-warning text-white d-inline-flex align-items-center justify-content-center" style="width: 30px; height: 30px; font-size: 0.85rem;">2</span>
                            <span>Payment Method</span>
                        </h4>
                        <span class="text-muted small"><i class="fa-solid fa-shield-halved text-success me-1"></i> 256-Bit SSL Encrypted</span>
                    </div>

                    <!-- Developer / Demo Auto-Fill Bar -->
                    <div class="demo-pay-bar">
                        <div class="small text-muted">
                            <i class="fa-solid fa-bolt text-warning me-1"></i> <strong>Demo Simulator:</strong> Test end-to-end checkout instantly.
                        </div>
                        <button type="button" class="btn-demo-autofill" id="btnAutoFillDemo">
                            <i class="fa-solid fa-wand-magic-sparkles me-1"></i> Auto-Fill Demo Card
                        </button>
                    </div>

                    <!-- Payment Navigation Tabs -->
                    <div class="payment-tabs-container">
                        <div class="payment-nav-tabs">
                            <!-- Tab 1: UPI -->
                            <div class="payment-tab-btn active" data-method="UPI" id="tabBtnUpi">
                                <i class="fa-solid fa-qrcode"></i>
                                <span>UPI &amp; QR</span>
                                <span class="payment-tab-pill">0% FEE &bull; INSTANT</span>
                            </div>

                            <!-- Tab 2: Cards -->
                            <div class="payment-tab-btn" data-method="Card" id="tabBtnCard">
                                <i class="fa-solid fa-credit-card"></i>
                                <span>Cards</span>
                                <span class="payment-tab-pill" style="background: #eff6ff; color: #2563eb;">VISA / MC / RUPAY</span>
                            </div>

                            <!-- Tab 3: NetBanking -->
                            <div class="payment-tab-btn" data-method="NetBanking" id="tabBtnNetBanking">
                                <i class="fa-solid fa-building-columns"></i>
                                <span>NetBanking</span>
                                <span class="payment-tab-pill" style="background: #fdf2f8; color: #be185d;">50+ BANKS</span>
                            </div>

                            <!-- Tab 4: Cash on Delivery -->
                            <div class="payment-tab-btn" data-method="COD" id="tabBtnCod">
                                <i class="fa-solid fa-hand-holding-dollar"></i>
                                <span>Cash / Doorstep</span>
                                <span class="payment-tab-pill" style="background: #fefce8; color: #a16207;">PAY ON ARRIVAL</span>
                            </div>
                        </div>
                    </div>

                    <!-- Payment Panels Container -->
                    <div class="payment-panels mb-4">
                        <!-- Panel 1: UPI -->
                        <div class="payment-panel active" id="panelUpi">
                            <div class="upi-box-wrapper">
                                <div class="row align-items-center g-3">
                                    <div class="col-md-5 text-center">
                                        <div class="upi-qr-card">
                                            <div class="upi-qr-frame">
                                                <div class="upi-qr-badge">NPCI / BHIM UPI</div>
                                                <!-- Dynamic SVG QR Code Representation -->
                                                <svg width="150" height="150" viewBox="0 0 150 150" fill="none" xmlns="http://www.w3.org/2000/svg" class="my-2">
                                                    <!-- QR Pattern Matrix -->
                                                    <rect width="150" height="150" fill="white"/>
                                                    <!-- Corner 1 -->
                                                    <rect x="10" y="10" width="36" height="36" rx="6" fill="#1e293b"/>
                                                    <rect x="16" y="16" width="24" height="24" rx="3" fill="white"/>
                                                    <rect x="22" y="22" width="12" height="12" rx="2" fill="#f5a623"/>
                                                    <!-- Corner 2 -->
                                                    <rect x="104" y="10" width="36" height="36" rx="6" fill="#1e293b"/>
                                                    <rect x="110" y="16" width="24" height="24" rx="3" fill="white"/>
                                                    <rect x="116" y="22" width="12" height="12" rx="2" fill="#f5a623"/>
                                                    <!-- Corner 3 -->
                                                    <rect x="10" y="104" width="36" height="36" rx="6" fill="#1e293b"/>
                                                    <rect x="16" y="110" width="24" height="24" rx="3" fill="white"/>
                                                    <rect x="22" y="116" width="12" height="12" rx="2" fill="#f5a623"/>
                                                    <!-- Data Dots Grid -->
                                                    <circle cx="56" cy="18" r="4" fill="#1e293b"/>
                                                    <circle cx="70" cy="18" r="4" fill="#1e293b"/>
                                                    <circle cx="84" cy="18" r="4" fill="#1e293b"/>
                                                    <circle cx="56" cy="32" r="4" fill="#1e293b"/>
                                                    <circle cx="75" cy="35" r="5" fill="#f5a623"/>
                                                    <circle cx="90" cy="32" r="4" fill="#1e293b"/>
                                                    <circle cx="18" cy="56" r="4" fill="#1e293b"/>
                                                    <circle cx="32" cy="56" r="4" fill="#1e293b"/>
                                                    <circle cx="46" cy="56" r="4" fill="#1e293b"/>
                                                    <circle cx="64" cy="56" r="4" fill="#1e293b"/>
                                                    <circle cx="78" cy="56" r="4" fill="#1e293b"/>
                                                    <circle cx="92" cy="56" r="4" fill="#1e293b"/>
                                                    <circle cx="106" cy="56" r="4" fill="#1e293b"/>
                                                    <circle cx="120" cy="56" r="4" fill="#1e293b"/>
                                                    <circle cx="134" cy="56" r="4" fill="#1e293b"/>
                                                    <!-- Center Foodly Icon -->
                                                    <rect x="58" y="58" width="34" height="34" rx="8" fill="#ffffff" stroke="#f5a623" stroke-width="2"/>
                                                    <circle cx="75" cy="75" r="10" fill="#f5a623"/>
                                                    <!-- Bottom Data Matrix -->
                                                    <circle cx="56" cy="98" r="4" fill="#1e293b"/>
                                                    <circle cx="70" cy="98" r="4" fill="#1e293b"/>
                                                    <circle cx="84" cy="98" r="4" fill="#1e293b"/>
                                                    <circle cx="98" cy="98" r="4" fill="#1e293b"/>
                                                    <circle cx="112" cy="98" r="4" fill="#1e293b"/>
                                                    <circle cx="126" cy="98" r="4" fill="#1e293b"/>
                                                    <circle cx="56" cy="118" r="4" fill="#1e293b"/>
                                                    <circle cx="70" cy="125" r="4" fill="#1e293b"/>
                                                    <circle cx="88" cy="118" r="4" fill="#1e293b"/>
                                                    <circle cx="106" cy="118" r="4" fill="#1e293b"/>
                                                    <circle cx="126" cy="118" r="4" fill="#1e293b"/>
                                                    <circle cx="56" cy="136" r="4" fill="#1e293b"/>
                                                    <circle cx="76" cy="136" r="4" fill="#1e293b"/>
                                                    <circle cx="96" cy="136" r="4" fill="#1e293b"/>
                                                    <circle cx="116" cy="136" r="4" fill="#1e293b"/>
                                                </svg>
                                            </div>
                                            <div class="small font-weight-bold text-dark mt-2">
                                                Scan to Pay <span class="text-warning">&#x20B9;@Model.TotalAmount.ToString("N2")</span>
                                            </div>
                                            <div class="text-muted" style="font-size: 0.72rem;">Accepts all UPI apps &amp; BHIM</div>
                                        </div>
                                    </div>
                                    <div class="col-md-7">
                                        <div class="font-weight-bold small text-dark mb-2">Or Pay via 1-Click UPI Apps:</div>
                                        <div class="upi-apps-grid">
                                            <div class="upi-app-option selected" data-app="GPay">
                                                <div class="fs-4 text-primary"><i class="fa-brands fa-google-pay"></i></div>
                                                <span class="upi-app-title">Google Pay</span>
                                            </div>
                                            <div class="upi-app-option" data-app="PhonePe">
                                                <div class="fs-4 text-purple" style="color: #6739b6;"><i class="fa-solid fa-mobile-screen-button"></i></div>
                                                <span class="upi-app-title">PhonePe</span>
                                            </div>
                                            <div class="upi-app-option" data-app="Paytm">
                                                <div class="fs-4 text-info"><i class="fa-solid fa-wallet"></i></div>
                                                <span class="upi-app-title">Paytm</span>
                                            </div>
                                            <div class="upi-app-option" data-app="CRED">
                                                <div class="fs-4 text-dark"><i class="fa-solid fa-shield-cat"></i></div>
                                                <span class="upi-app-title">CRED UPI</span>
                                            </div>
                                        </div>

                                        <div class="mb-2">
                                            <label class="form-label font-weight-bold small text-secondary">Or Enter UPI ID / VPA</label>
                                            <div class="input-group">
                                                <input type="text" name="UpiVpa" id="inputUpiVpa" class="form-control rounded-start-3" placeholder="username@upi" />
                                                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnVerifyVpa">Verify</button>
                                            </div>
                                            <div class="d-flex gap-1 mt-1 flex-wrap">
                                                <span class="badge bg-light text-dark border upi-handle-pill" style="cursor: pointer;">&#64;okhdfcbank</span>
                                                <span class="badge bg-light text-dark border upi-handle-pill" style="cursor: pointer;">&#64;oksbi</span>
                                                <span class="badge bg-light text-dark border upi-handle-pill" style="cursor: pointer;">&#64;paytm</span>
                                                <span class="badge bg-light text-dark border upi-handle-pill" style="cursor: pointer;">&#64;ybl</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Panel 2: Credit / Debit Cards -->
                        <div class="payment-panel" id="panelCard">
                            <!-- Interactive Card Preview -->
                            <div class="credit-card-preview">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="card-chip"></div>
                                    <div class="card-brand-icon" id="previewCardBrand">
                                        <i class="fa-brands fa-cc-visa"></i>
                                    </div>
                                </div>
                                <div class="card-preview-number" id="previewCardNumber">&bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; 4242</div>
                                <div class="card-preview-meta">
                                    <div>
                                        <div class="text-muted small" style="font-size: 0.68rem; letter-spacing: 0.5px;">CARDHOLDER</div>
                                        <div class="card-holder-name" id="previewCardHolder">SAILEN MONDAL</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="text-muted small" style="font-size: 0.68rem; letter-spacing: 0.5px;">EXPIRES</div>
                                        <div class="card-expiry-preview" id="previewCardExpiry">12/28</div>
                                    </div>
                                </div>
                            </div>

                            <!-- Card Input Fields -->
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label font-weight-bold small text-secondary">Cardholder Name</label>
                                    <input type="text" name="CardHolderName" id="inputCardHolder" class="form-control rounded-3" placeholder="Full name as printed on card" value="Sailen Mondal" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label font-weight-bold small text-secondary">Card Number</label>
                                    <div class="input-group">
                                        <input type="text" name="CardNumber" id="inputCardNumber" class="form-control rounded-start-3 font-monospace" placeholder="4000 1234 5678 9010" maxlength="19" />
                                        <span class="input-group-text bg-light text-secondary" id="cardNumberIcon">
                                            <i class="fa-brands fa-cc-visa text-primary fs-5"></i>
                                        </span>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <label class="form-label font-weight-bold small text-secondary">Expiry Date</label>
                                    <input type="text" name="CardExpiry" id="inputCardExpiry" class="form-control rounded-3 font-monospace" placeholder="MM/YY" maxlength="5" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label font-weight-bold small text-secondary d-flex align-items-center justify-content-between">
                                        <span>CVV / CVC</span>
                                        <span class="text-muted" style="cursor: help;" title="3-digit security code on the signature strip on the back of your card. Strictly never stored on our servers."><i class="fa-solid fa-circle-question"></i></span>
                                    </label>
                                    <input type="password" name="CardCvv" id="inputCardCvv" class="form-control rounded-3 font-monospace" placeholder="•••" maxlength="4" />
                                </div>
                            </div>
                            <div class="alert alert-info py-2 px-3 small mt-3 mb-0 rounded-3">
                                <i class="fa-solid fa-shield-halved me-1"></i> <strong>RBI CoFT Compliant:</strong> We strictly adhere to Reserve Bank of India tokenization directives. Your CVV and plaintext card number are never stored.
                            </div>
                        </div>

                        <!-- Panel 3: NetBanking -->
                        <div class="payment-panel" id="panelNetBanking">
                            <div class="font-weight-bold small text-dark mb-2">Select from Top Indian Banks:</div>
                            <div class="bank-grid">
                                <div class="bank-option selected" data-bank="HDFC Bank">
                                    <div class="fs-4 text-primary"><i class="fa-solid fa-landmark"></i></div>
                                    <span class="bank-title">HDFC Bank</span>
                                </div>
                                <div class="bank-option" data-bank="ICICI Bank">
                                    <div class="fs-4 text-danger"><i class="fa-solid fa-landmark"></i></div>
                                    <span class="bank-title">ICICI Bank</span>
                                </div>
                                <div class="bank-option" data-bank="State Bank of India">
                                    <div class="fs-4 text-info"><i class="fa-solid fa-landmark"></i></div>
                                    <span class="bank-title">SBI</span>
                                </div>
                                <div class="bank-option" data-bank="Axis Bank">
                                    <div class="fs-4 text-purple" style="color: #8b5cf6;"><i class="fa-solid fa-landmark"></i></div>
                                    <span class="bank-title">Axis Bank</span>
                                </div>
                                <div class="bank-option" data-bank="Kotak Mahindra Bank">
                                    <div class="fs-4 text-danger"><i class="fa-solid fa-landmark"></i></div>
                                    <span class="bank-title">Kotak Bank</span>
                                </div>
                                <div class="bank-option" data-bank="Punjab National Bank">
                                    <div class="fs-4 text-warning"><i class="fa-solid fa-landmark"></i></div>
                                    <span class="bank-title">PNB</span>
                                </div>
                            </div>

                            <div class="mb-2">
                                <label class="form-label font-weight-bold small text-secondary">All Other Supported Banks</label>
                                <select class="form-select rounded-3" id="selectOtherBank">
                                    <option value="">-- Choose your bank (50+ available) --</option>
                                    <option value="Bank of Baroda">Bank of Baroda</option>
                                    <option value="Canara Bank">Canara Bank</option>
                                    <option value="Union Bank of India">Union Bank of India</option>
                                    <option value="IndusInd Bank">IndusInd Bank</option>
                                    <option value="IDBI Bank">IDBI Bank</option>
                                    <option value="Federal Bank">Federal Bank</option>
                                    <option value="Yes Bank">Yes Bank</option>
                                </select>
                            </div>
                        </div>

                        <!-- Panel 4: Cash on Delivery -->
                        <div class="payment-panel" id="panelCod">
                            <div class="cod-security-box">
                                <div class="cod-seal-icon">
                                    <i class="fa-solid fa-shield-check"></i>
                                </div>
                                <div>
                                    <h5 class="font-weight-bold text-success mb-1">Pay on Arrival Guaranteed</h5>
                                    <p class="text-secondary small mb-2">
                                        Pay in cash or scan the delivery partner's dynamic UPI QR code when your hot food arrives at your door.
                                    </p>
                                    <div class="d-flex align-items-center gap-3 small text-muted">
                                        <span><i class="fa-solid fa-money-bill me-1 text-success"></i> Exact change accepted</span>
                                        <span><i class="fa-solid fa-qrcode me-1 text-primary"></i> Doorstep UPI QR</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Single Authoritative Action Button -->
                    <button type="submit" id="btnPlaceOrder" class="btn btn-warning text-white rounded-pill w-100 py-3 font-weight-bold shadow fs-5">
                        <i class="fa-solid fa-lock me-2"></i> Confirm &amp; Place Order (&#x20B9;@Model.TotalAmount.ToString("N2"))
                    </button>
                }
            </div>

            <!-- Security Trust Badges Bar (Footer) -->
            <div class="pci-security-bar">
                <div class="security-badge-item">
                    <i class="fa-solid fa-lock"></i>
                    <span>256-Bit SSL Protection</span>
                </div>
                <div class="security-badge-item">
                    <i class="fa-solid fa-shield-halved"></i>
                    <span>PCI-DSS Level 1 Safe</span>
                </div>
                <div class="security-badge-item">
                    <i class="fa-solid fa-building-shield"></i>
                    <span>RBI CoFT Compliant</span>
                </div>
                <div class="security-badge-item">
                    <i class="fa-solid fa-bolt"></i>
                    <span>Instant Refund Safe</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Column: Order Summary Card -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white sticky-top" style="top: 80px;">
            <div class="d-flex align-items-center justify-content-between mb-3 border-bottom pb-2">
                <h5 class="font-weight-bold m-0 d-flex align-items-center gap-2">
                    <i class="fa-solid fa-bag-shopping text-warning"></i>
                    <span>Order Summary</span>
                </h5>
                <span class="badge bg-light text-dark border">@Model.Items.Sum(i => i.Quantity) items</span>
            </div>

            <!-- Itemized List -->
            <div class="border-bottom pb-3 mb-3" style="max-height: 280px; overflow-y: auto;">
                @foreach (var item in Model.Items)
                {
                    <div class="d-flex align-items-center justify-content-between py-2">
                        <div class="d-flex align-items-center gap-2">
                            <span class="diet-badge @(item.IsVeg ? "veg" : "nonveg")"></span>
                            <div>
                                <div class="font-weight-bold small">@item.Name</div>
                                <div class="text-muted small">&#x20B9;@item.Price.ToString("N2") &times; @item.Quantity</div>
                            </div>
                        </div>
                        <div class="font-weight-bold">&#x20B9;@item.TotalPrice.ToString("N2")</div>
                    </div>
                }
            </div>

            <!-- Pricing Calculation -->
            <div class="d-flex justify-content-between mb-2 small text-muted">
                <span>Items Subtotal</span>
                <span>&#x20B9;@Model.SubTotal.ToString("N2")</span>
            </div>
            <div class="d-flex justify-content-between mb-3 small text-muted">
                <span>Delivery Charge</span>
                <span>
                    @if (Model.DeliveryFee == 0)
                    {
                        <span class="text-success font-weight-bold">FREE (Orders above &#x20B9;500)</span>
                    }
                    else
                    {
                        <span>&#x20B9;@Model.DeliveryFee.ToString("N2")</span>
                    }
                </span>
            </div>

            <div class="d-flex justify-content-between pt-3 border-top fs-5 font-weight-bold">
                <span>Total Payable</span>
                <span class="text-warning">&#x20B9;@Model.TotalAmount.ToString("N2")</span>
            </div>

            <div class="alert alert-warning py-2 mt-3 small mb-0 rounded-3 d-flex align-items-center gap-2">
                <i class="fa-solid fa-stopwatch text-warning fs-5"></i>
                <div>Kitchen begins fresh preparation immediately upon your payment confirmation.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            // Tab Switching Logic
            $('.payment-tab-btn').on('click', function () {
                var method = $(this).data('method');
                $('.payment-tab-btn').removeClass('active');
                $(this).addClass('active');

                $('#selectedPaymentMethod').val(method);
                $('.payment-panel').removeClass('active');

                if (method === 'UPI') {
                    $('#panelUpi').addClass('active');
                } else if (method === 'Card') {
                    $('#panelCard').addClass('active');
                } else if (method === 'NetBanking') {
                    $('#panelNetBanking').addClass('active');
                } else if (method === 'COD') {
                    $('#panelCod').addClass('active');
                }
            });

            // UPI App Selection
            $('.upi-app-option').on('click', function () {
                $('.upi-app-option').removeClass('selected');
                $(this).addClass('selected');
                var app = $(this).data('app');
                $('#selectedUpiApp').val(app);
            });

            // UPI Handle Quick Fill
            $('.upi-handle-pill').on('click', function () {
                var handle = $(this).text().trim();
                var currentVal = $('#inputUpiVpa').val();
                var username = currentVal.indexOf('@@') !== -1 ? currentVal.split('@@')[0] : (currentVal || 'foodlover');
                $('#inputUpiVpa').val(username + handle);
            });

            // Interactive Card Live Preview
            $('#inputCardHolder').on('input', function () {
                var val = $(this).val().trim();
                $('#previewCardHolder').text(val.length > 0 ? val.toUpperCase() : 'YOUR NAME');
            });

            $('#inputCardNumber').on('input', function () {
                var val = $(this).val().replace(/\D/g, '');
                var formatted = val.replace(/(\d{4})/g, '$1 ').trim();
                $(this).val(formatted);

                // Detect Brand
                var brandIcon = '<i class="fa-brands fa-cc-visa text-primary"></i>';
                var network = 'Visa';
                if (/^5[1-5]/.test(val) || /^2[2-7]/.test(val)) {
                    brandIcon = '<i class="fa-brands fa-cc-mastercard text-danger"></i>';
                    network = 'Mastercard';
                } else if (/^60|^6521|^6522/.test(val) || /^508/.test(val)) {
                    brandIcon = '<i class="fa-solid fa-credit-card text-success"></i>';
                    network = 'RuPay';
                } else if (/^3[47]/.test(val)) {
                    brandIcon = '<i class="fa-brands fa-cc-amex text-info"></i>';
                    network = 'Amex';
                }
                $('#cardNumberIcon').html(brandIcon);
                $('#previewCardBrand').html(brandIcon);
                $('#selectedCardNetwork').val(network);

                // Update preview number
                if (val.length >= 4) {
                    var last4 = val.slice(-4);
                    $('#previewCardNumber').html('&bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; ' + last4);
                } else {
                    $('#previewCardNumber').html('&bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; &bull;&bull;&bull;&bull; 4242');
                }
            });

            $('#inputCardExpiry').on('input', function () {
                var val = $(this).val().replace(/\D/g, '');
                if (val.length >= 2) {
                    val = val.substring(0, 2) + '/' + val.substring(2, 4);
                }
                $(this).val(val);
                $('#previewCardExpiry').text(val.length > 0 ? val : '12/28');
            });

            // NetBanking Selection
            $('.bank-option').on('click', function () {
                $('.bank-option').removeClass('selected');
                $(this).addClass('selected');
                var bank = $(this).data('bank');
                $('#selectedBankInput').val(bank);
                $('#selectOtherBank').val('');
            });

            $('#selectOtherBank').on('change', function () {
                var bank = $(this).val();
                if (bank) {
                    $('.bank-option').removeClass('selected');
                    $('#selectedBankInput').val(bank);
                }
            });

            // Demo Auto-Fill Simulator
            $('#btnAutoFillDemo').on('click', function () {
                $('#tabBtnCard').trigger('click');
                $('#inputCardHolder').val('Sailen Mondal').trigger('input');
                $('#inputCardNumber').val('4532 8824 9912 4242').trigger('input');
                $('#inputCardExpiry').val('09/29').trigger('input');
                $('#inputCardCvv').val('888');
            });

            // Prevent Double Submissions
            $('#checkoutForm').on('submit', function () {
                var btn = $('#btnPlaceOrder');
                if (btn.prop('disabled')) {
                    return false;
                }
                btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-2"></i> Processing Secure Payment...');
                return true;
            });
        });
    </script>
}
