@model FoodDeliveryApp.Models.ViewModels.HomeIndexViewModel
@{
    ViewBag.Title = "Order Authentic Food Online";
}

<!-- Sizzling Gourmet Culinary Hero Section -->
<div class="foodly-hero" id="heroContainer">
    <div class="row align-items-center g-4">
        <!-- Left Column: Typography, Live Dispatch Telemetry & CTAs -->
        <div class="col-lg-6">
            <!-- Live Kitchen Dispatch Telemetry Badge -->
            <div class="kitchen-telemetry-badge">
                <span class="kitchen-pulse-dot"></span>
                <span class="kitchen-telemetry-text">Live Kitchen Dispatch Active</span>
                <span class="kitchen-telemetry-meta d-none d-sm-inline">&bull; Next Handi: <strong>8m</strong> &bull; Express 30-Min</span>
            </div>

            <h1 class="foodly-hero-title">
                Savor Authentic <span class="highlight">Steaming Hot Gourmet</span> &amp; Street Delights
            </h1>
            <p class="foodly-hero-subtitle">
                From fragrant slow-dum biryanis and rich butter paneer to artisan woodfired pizzas and crisp kathi rolls, relish your favorites hot at your door.
            </p>

            <!-- Primary CTAs -->
            <div class="d-flex flex-wrap align-items-center gap-3">
                @if (!User.IsInRole("Admin"))
                {
                    <a href="@Url.Action("Index", "Menu")" class="btn-foodly-order-now px-4 py-2" style="font-size: 1.05rem;">
                        <i class="fa-solid fa-utensils me-2"></i> Explore Full Menu
                    </a>
                }
                else
                {
                    <a href="@Url.Action("Orders", "Admin")" class="btn btn-dark text-warning rounded-pill px-4 py-2 font-weight-bold shadow-sm" style="font-size: 1.05rem;">
                        <i class="fa-solid fa-clipboard-list me-2"></i> Kitchen Orders Queue
                    </a>
                }
                <a href="#bestsellers" class="btn btn-outline-dark rounded-pill px-4 py-2 font-weight-bold" style="border-width: 2px;">
                    Today's Specials
                </a>
            </div>

            <!-- Accessibility Motion Toggle (WCAG 2.2.2 & Modern Web Guidance) -->
            <div class="mt-3">
                <button type="button" class="btn-hero-motion-toggle" id="btnToggleHeroMotion" aria-pressed="false" title="Pause live background steam and dish rotations">
                    <i class="fa-solid fa-pause"></i>
                    <span id="motionToggleText">Pause Animation</span>
                </button>
            </div>

            <!-- Social Proof Strip -->
            <div class="d-flex align-items-center gap-3 mt-4 pt-3 border-top text-secondary small flex-wrap">
                <div class="d-flex align-items-center gap-1">
                    <i class="fa-solid fa-star text-warning"></i>
                    <strong>4.9 / 5</strong>
                    <span class="text-muted">(18,000+ Foodies)</span>
                </div>
                <span class="text-muted">&bull;</span>
                <div class="d-flex align-items-center gap-1">
                    <i class="fa-solid fa-shield-halved text-success"></i>
                    <span>100% Contactless</span>
                </div>
                <span class="text-muted">&bull;</span>
                <div class="d-flex align-items-center gap-1">
                    <i class="fa-solid fa-fire text-danger"></i>
                    <span>Insulated Multi-Layer Bags</span>
                </div>
            </div>
        </div>

        <!-- Right Column: The Sizzling Gourmet Culinary Stage -->
        <div class="col-lg-6">
            <div class="culinary-stage-container" id="culinaryStage" data-dish="biryani">
                <!-- Warm Ambient Earthen Backlight -->
                <div class="culinary-ambient-glow" aria-hidden="true"></div>

                <!-- Floating Aroma Badges (Desktop Orbital / Mobile Docked Flex Row) -->
                <div class="mobile-aroma-dock">
                    <div class="floating-aroma-badge badge-hot-dum">
                        <i class="fa-solid fa-fire-burner text-danger"></i>
                        <span>Steaming Hot &bull; Handi Dum</span>
                    </div>

                    <div class="floating-aroma-badge badge-speed-dispatch">
                        <i class="fa-solid fa-bolt text-warning"></i>
                        <span>25-Min Express Dispatch</span>
                    </div>

                    <div class="floating-aroma-badge badge-social-proof">
                        <i class="fa-solid fa-star text-warning"></i>
                        <span>4.9 Rated &bull; 1.2k+ Orders Today</span>
                    </div>
                </div>

                <!-- Platter Stage Wrapper -->
                <div class="culinary-platter-stage">
                    <!-- Rising Steam SVG Emitter (Compositor-Accelerated Curved Vapor) -->
                    <svg class="steam-emitter" viewBox="0 0 280 160" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path class="steam-plume steam-plume-1" d="M120 150 C110 120, 135 90, 115 50 C105 30, 125 15, 110 5" />
                        <path class="steam-plume steam-plume-2" d="M140 155 C155 125, 130 95, 150 55 C160 35, 145 18, 155 5" />
                        <path class="steam-plume steam-plume-3" d="M100 150 C85 120, 110 85, 95 45 C85 25, 105 10, 90 2" />
                        <path class="steam-plume steam-plume-4" d="M165 155 C180 125, 160 90, 175 50 C185 30, 170 15, 180 3" />
                    </svg>

                    <!-- Featured Dish 1: Hyderabadi Dum Biryani -->
                    <img src="@Url.Content("~/Content/images/dishes/dish-1.jpg")"
                         alt="Hyderabadi Dum Biryani steaming hot"
                         class="culinary-dish-img active"
                         id="dishImgBiryani"
                         data-dish="biryani" />

                    <!-- Featured Dish 2: Woodfired Pepperoni Pizza -->
                    <img src="@Url.Content("~/Content/images/dishes/dish-5.jpg")"
                         alt="Spicy Chicken Pepperoni Pizza steaming hot"
                         class="culinary-dish-img"
                         id="dishImgPizza"
                         data-dish="pizza" />

                    <!-- Featured Dish 3: Paneer Butter Masala -->
                    <img src="@Url.Content("~/Content/images/dishes/dish-11.jpg")"
                         alt="Paneer Butter Masala Combo steaming hot"
                         class="culinary-dish-img"
                         id="dishImgPaneer"
                         data-dish="paneer" />
                </div>

                <!-- Interactive Dish Selector Chips (role="tablist") -->
                <div class="culinary-dish-tabs" role="tablist" aria-label="Featured Culinary Showcase">
                    <button type="button" role="tab" class="dish-tab-chip active" data-dish="biryani" aria-selected="true" aria-controls="dishImgBiryani" id="tabBiryani">
                        <i class="fa-solid fa-bowl-rice"></i>
                        <span>Dum Biryani</span>
                    </button>
                    <button type="button" role="tab" class="dish-tab-chip" data-dish="pizza" aria-selected="false" aria-controls="dishImgPizza" id="tabPizza">
                        <i class="fa-solid fa-pizza-slice"></i>
                        <span>Artisan Pizza</span>
                    </button>
                    <button type="button" role="tab" class="dish-tab-chip" data-dish="paneer" aria-selected="false" aria-controls="dishImgPaneer" id="tabPaneer">
                        <i class="fa-solid fa-plate-wheat"></i>
                        <span>Paneer Butter</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Popular Categories Bar -->
<div class="mb-5">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="font-weight-bold m-0" style="letter-spacing: -0.3px;"><i class="fa-solid fa-shapes text-warning me-2"></i> Popular Categories</h4>
        <a href="@Url.Action("Index", "Menu")" class="text-decoration-none text-warning font-weight-bold small">
            View All <i class="fa-solid fa-chevron-right ms-1"></i>
        </a>
    </div>
    <div class="d-flex gap-2 overflow-auto pb-2" style="scrollbar-width: thin;">
        <a href="@Url.Action("Index", "Menu")" class="category-pill active">
            <span>All Categories</span>
        </a>
        @foreach (var cat in Model.Categories)
        {
            <a href="@Url.Action("Index", "Menu", new { categoryId = cat.CategoryId })" class="category-pill">
                <span>@cat.Name</span>
            </a>
        }
    </div>
</div>

<!-- Chef's Bestsellers Grid -->
<div id="bestsellers" class="mb-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="font-weight-bold m-0" style="letter-spacing: -0.5px;"><i class="fa-solid fa-star text-warning me-2"></i> Chef's Bestsellers</h3>
            <p class="text-muted small m-0 mt-1">Most loved delicacies ordered by foodies across the country</p>
        </div>
        <a href="@Url.Action("Index", "Menu")" class="btn btn-sm btn-outline-warning rounded-pill px-3 font-weight-bold">
            Full Catalog &rarr;
        </a>
    </div>

    <div class="row g-4">
        @for (int i = 0; i < Model.Bestsellers.Count; i++)
        {
            var item = Model.Bestsellers[i];
            <div class="col-xl-3 col-lg-4 col-sm-6">
                <div class="foodly-card">
                    <div class="foodly-card-img-wrap">
                        <span class="foodly-badge-tag @(i % 2 == 0 ? "bestseller" : "trending")">
                            @(i % 2 == 0 ? "BESTSELLER" : "HOT & FRESH")
                        </span>
                        <button type="button" class="foodly-card-fav" title="Save to Favorites" aria-label="Save to Favorites">
                            <i class="fa-regular fa-heart"></i>
                        </button>
                        <img src="@item.ImageUrl" alt="@item.Name" class="foodly-card-img" onerror="this.src='/Content/images/dishes/dish-1.jpg'" />
                    </div>
                    <div class="foodly-card-body">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="diet-badge @(item.IsVeg ? "veg" : "nonveg")" title="@(item.IsVeg ? "Pure Vegetarian" : "Non-Vegetarian")"></span>
                            <span class="badge bg-light text-secondary border small">@item.CategoryName</span>
                        </div>
                        <h5 class="foodly-card-title">@item.Name</h5>
                        <p class="foodly-card-desc">@item.Description</p>
                        <div class="foodly-card-meta">
                            <span class="foodly-card-rating">
                                <i class="fa-solid fa-star star"></i> @item.Rating.ToString("0.0")
                                <span class="text-muted font-weight-normal small">(@(120 + i * 15))</span>
                            </span>
                            <span class="foodly-card-prep">
                                <i class="fa-regular fa-clock"></i> @item.PrepTimeMinutes min
                            </span>
                        </div>
                        <div class="foodly-card-footer">
                            <div class="foodly-card-price">&#x20B9;@item.Price.ToString("N0")</div>
                            @if (!User.IsInRole("Admin"))
                            {
                                <button type="button" class="btn-circular-add" data-item-id="@item.ItemId" title="Add to Basket" aria-label="Add to Basket">
                                    +
                                </button>
                            }
                            else
                            {
                                <a href="@Url.Action("MenuItems", "Admin")" class="btn-circular-admin-edit" title="Manage Item in Admin Inventory" aria-label="Manage Item in Admin Inventory">
                                    <i class="fa-solid fa-pen-to-square"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Why Choose Foodly Banner -->
<div class="row g-4 my-5 py-4 bg-white rounded-4 border shadow-sm">
    <div class="col-md-4 text-center px-4">
        <div class="text-warning fs-1 mb-2"><i class="fa-solid fa-bowl-rice"></i></div>
        <h5 class="font-weight-bold">Finest Master Recipes</h5>
        <p class="text-muted small">Hand-picked spices and slow-cooked preparations crafted by master chefs.</p>
    </div>
    <div class="col-md-4 text-center px-4 border-start border-end">
        <div class="text-warning fs-1 mb-2"><i class="fa-solid fa-motorcycle"></i></div>
        <h5 class="font-weight-bold">Lightning Fast Delivery</h5>
        <p class="text-muted small">Insulated multi-compartment delivery bags keep dishes steaming hot upon arrival.</p>
    </div>
    <div class="col-md-4 text-center px-4">
        <div class="text-warning fs-1 mb-2"><i class="fa-solid fa-shield-heart"></i></div>
        <h5 class="font-weight-bold">FSSAI Certified Hygiene</h5>
        <p class="text-muted small">Temperature checked kitchen stations and 100% contactless dispatch standards.</p>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var dishes = ['biryani', 'pizza', 'paneer'];
            var currentIndex = 0;
            var autoRotateTimer = null;
            var isUserPaused = false;
            var isHoverPaused = false;
            var heroContainer = document.getElementById('heroContainer');
            var stage = document.getElementById('culinaryStage');
            var motionBtn = document.getElementById('btnToggleHeroMotion');
            var motionBtnText = document.getElementById('motionToggleText');
            var chips = document.querySelectorAll('.dish-tab-chip');
            var images = document.querySelectorAll('.culinary-dish-img');

            function switchDish(targetDish) {
                var foundIndex = dishes.indexOf(targetDish);
                if (foundIndex === -1) return;
                currentIndex = foundIndex;

                // Update stage dataset for dish-aware steam profiles
                if (stage) {
                    stage.setAttribute('data-dish', targetDish);
                }

                // Update images
                images.forEach(function (img) {
                    if (img.getAttribute('data-dish') === targetDish) {
                        img.classList.add('active');
                    } else {
                        img.classList.remove('active');
                    }
                });

                // Update tab buttons
                chips.forEach(function (btn) {
                    var isSelected = btn.getAttribute('data-dish') === targetDish;
                    btn.classList.toggle('active', isSelected);
                    btn.setAttribute('aria-selected', isSelected ? 'true' : 'false');
                });
            }

            function startAutoRotate() {
                stopAutoRotate();
                // Check prefers-reduced-motion
                if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    return;
                }
                if (isUserPaused || isHoverPaused) return;

                autoRotateTimer = setInterval(function () {
                    currentIndex = (currentIndex + 1) % dishes.length;
                    switchDish(dishes[currentIndex]);
                }, 6000);
            }

            function stopAutoRotate() {
                if (autoRotateTimer) {
                    clearInterval(autoRotateTimer);
                    autoRotateTimer = null;
                }
            }

            // Tab click handling
            chips.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var targetDish = this.getAttribute('data-dish');
                    switchDish(targetDish);
                    startAutoRotate(); // Reset 6-second timer
                });
            });

            // Pause on hover / touch / focus (WCAG 2.2.2 compliance)
            if (stage) {
                stage.addEventListener('pointerenter', function () {
                    isHoverPaused = true;
                    stopAutoRotate();
                });

                stage.addEventListener('pointerleave', function () {
                    isHoverPaused = false;
                    startAutoRotate();
                });

                stage.addEventListener('focusin', function () {
                    isHoverPaused = true;
                    stopAutoRotate();
                });

                stage.addEventListener('focusout', function () {
                    isHoverPaused = false;
                    startAutoRotate();
                });
            }

            // Unified Motion Toggle Button
            if (motionBtn && heroContainer) {
                motionBtn.addEventListener('click', function () {
                    isUserPaused = !isUserPaused;
                    this.setAttribute('aria-pressed', isUserPaused ? 'true' : 'false');

                    if (isUserPaused) {
                        heroContainer.setAttribute('data-motion', 'paused');
                        motionBtn.innerHTML = '<i class="fa-solid fa-play"></i> <span>Resume Animation</span>';
                        stopAutoRotate();
                    } else {
                        heroContainer.removeAttribute('data-motion');
                        motionBtn.innerHTML = '<i class="fa-solid fa-pause"></i> <span>Pause Animation</span>';
                        startAutoRotate();
                    }
                });
            }

            // IntersectionObserver: Pause compositor animations when scrolled off-screen (Battery / GPU conservation)
            if ('IntersectionObserver' in window && heroContainer) {
                var observer = new IntersectionObserver(function (entries) {
                    entries.forEach(function (entry) {
                        if (entry.isIntersecting) {
                            heroContainer.classList.remove('is-hero-offscreen');
                            if (!isUserPaused && !isHoverPaused) {
                                startAutoRotate();
                            }
                        } else {
                            heroContainer.classList.add('is-hero-offscreen');
                            stopAutoRotate();
                        }
                    });
                }, { threshold: 0.15 });

                observer.observe(heroContainer);
            }

            // Page Visibility Lifecycle: Pause on background tab
            document.addEventListener('visibilitychange', function () {
                if (document.hidden) {
                    if (heroContainer) heroContainer.classList.add('is-hero-offscreen');
                    stopAutoRotate();
                } else {
                    if (heroContainer) heroContainer.classList.remove('is-hero-offscreen');
                    if (!isUserPaused && !isHoverPaused) {
                        startAutoRotate();
                    }
                }
            });

            // Start rotation on page ready
            startAutoRotate();
        })();
    </script>
}
