@model FoodDeliveryApp.Models.ViewModels.HomeIndexViewModel
@{
    ViewBag.Title = "Order Authentic Food Online";
}

<!-- Hero Section -->
<div class="foodly-hero">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <div class="foodly-hero-badge">
                <i class="fa-solid fa-fire text-danger"></i>
                <span>Freshly Cooked &bull; Express 30-Min Delivery</span>
            </div>
            <h1 class="foodly-hero-title">
                Savor Authentic <span class="highlight">Gourmet Dishes</span> &amp; Street Delights
            </h1>
            <p class="foodly-hero-subtitle">
                From fragrant Hyderabadi Dum Biryanis and rich butter paneer to artisan pizzas and crisp kathi rolls, relish your favorites hot at your door.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a href="@Url.Action("Index", "Menu")" class="btn-foodly-order-now px-4 py-2" style="font-size: 1.05rem;">
                    <i class="fa-solid fa-utensils me-2"></i> Explore Full Menu
                </a>
                <a href="#bestsellers" class="btn btn-outline-dark rounded-pill px-4 py-2 font-weight-bold" style="border-width: 2px;">
                    Today's Specials
                </a>
            </div>
        </div>
        <div class="col-lg-5 d-none d-lg-block text-center position-relative">
            <img src="@Url.Content("~/Content/images/dishes/dish-1.jpg")"
                 alt="Hyderabadi Dum Biryani"
                 class="img-fluid rounded-4 shadow-lg"
                 style="max-height: 380px; width: 100%; object-fit: cover; border: 4px solid #ffffff;" />
        </div>
    </div>
</div>

<!-- Popular Categories Bar -->
<div class="mb-5">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="font-weight-bold m-0" style="letter-spacing: -0.3px;"><i class="fa-solid fa-shapes text-warning me-2"></i> Popular Categories</h4>
        <a href="@Url.Action("Index", "Menu")" class="text-decoration-none text-warning font-weight-bold small">
            View All <i class="fa-solid fa-chevron-right ms-1"></i>
        </a>
    </div>
    <div class="d-flex gap-2 overflow-auto pb-2" style="scrollbar-width: thin;">
        <a href="@Url.Action("Index", "Menu")" class="category-pill active">
            <span>All Categories</span>
        </a>
        @foreach (var cat in Model.Categories)
        {
            <a href="@Url.Action("Index", "Menu", new { categoryId = cat.CategoryId })" class="category-pill">
                <span>@cat.Name</span>
            </a>
        }
    </div>
</div>

<!-- Chef's Bestsellers Grid -->
<div id="bestsellers" class="mb-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="font-weight-bold m-0" style="letter-spacing: -0.5px;"><i class="fa-solid fa-star text-warning me-2"></i> Chef's Bestsellers</h3>
            <p class="text-muted small m-0 mt-1">Most loved delicacies ordered by foodies across the country</p>
        </div>
        <a href="@Url.Action("Index", "Menu")" class="btn btn-sm btn-outline-warning rounded-pill px-3 font-weight-bold">
            Full Catalog &rarr;
        </a>
    </div>

    <div class="row g-4">
        @for (int i = 0; i < Model.Bestsellers.Count; i++)
        {
            var item = Model.Bestsellers[i];
            <div class="col-xl-3 col-lg-4 col-sm-6">
                <div class="foodly-card">
                    <div class="foodly-card-img-wrap">
                        <span class="foodly-badge-tag @(i % 2 == 0 ? "bestseller" : "trending")">
                            @(i % 2 == 0 ? "BESTSELLER" : "HOT & FRESH")
                        </span>
                        <button type="button" class="foodly-card-fav" title="Save to Favorites" aria-label="Save to Favorites">
                            <i class="fa-regular fa-heart"></i>
                        </button>
                        <img src="@item.ImageUrl" alt="@item.Name" class="foodly-card-img" onerror="this.src='/Content/images/dishes/dish-1.jpg'" />
                    </div>
                    <div class="foodly-card-body">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="diet-badge @(item.IsVeg ? "veg" : "nonveg")" title="@(item.IsVeg ? "Pure Vegetarian" : "Non-Vegetarian")"></span>
                            <span class="badge bg-light text-secondary border small">@item.CategoryName</span>
                        </div>
                        <h5 class="foodly-card-title">@item.Name</h5>
                        <p class="foodly-card-desc">@item.Description</p>
                        <div class="foodly-card-meta">
                            <span class="foodly-card-rating">
                                <i class="fa-solid fa-star star"></i> @item.Rating.ToString("0.0")
                                <span class="text-muted font-weight-normal small">(@(120 + i * 15))</span>
                            </span>
                            <span class="foodly-card-prep">
                                <i class="fa-regular fa-clock"></i> @item.PrepTimeMinutes min
                            </span>
                        </div>
                        <div class="foodly-card-footer">
                            <div class="foodly-card-price">&#x20B9;@item.Price.ToString("N0")</div>
                            <button type="button" class="btn-circular-add" data-item-id="@item.ItemId" title="Add to Basket" aria-label="Add to Basket">
                                +
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Why Choose Foodly Banner -->
<div class="row g-4 my-5 py-4 bg-white rounded-4 border shadow-sm">
    <div class="col-md-4 text-center px-4">
        <div class="text-warning fs-1 mb-2"><i class="fa-solid fa-bowl-rice"></i></div>
        <h5 class="font-weight-bold">Finest Master Recipes</h5>
        <p class="text-muted small">Hand-picked spices and slow-cooked preparations crafted by master chefs.</p>
    </div>
    <div class="col-md-4 text-center px-4 border-start border-end">
        <div class="text-warning fs-1 mb-2"><i class="fa-solid fa-motorcycle"></i></div>
        <h5 class="font-weight-bold">Lightning Fast Delivery</h5>
        <p class="text-muted small">Insulated multi-compartment delivery bags keep dishes steaming hot upon arrival.</p>
    </div>
    <div class="col-md-4 text-center px-4">
        <div class="text-warning fs-1 mb-2"><i class="fa-solid fa-shield-heart"></i></div>
        <h5 class="font-weight-bold">FSSAI Certified Hygiene</h5>
        <p class="text-muted small">Temperature checked kitchen stations and 100% contactless dispatch standards.</p>
    </div>
</div>
