@{
    ViewBag.Title = "About Foodly Kitchen";
}

<div class="row g-4 align-items-center mb-5">
    <div class="col-lg-6">
        <div class="foodly-hero-badge mb-2">
            <i class="fa-solid fa-seedling text-success"></i>
            <span>Our Heritage &amp; Passion</span>
        </div>
        <h2 class="font-weight-bold display-6 mb-3">
            Crafting India's Finest <span class="text-warning">Regional &amp; Modern</span> Flavors
        </h2>
        <p class="text-secondary lead fs-6 mb-4">
            @ViewBag.Message
        </p>
        <p class="text-muted small">
            Founded with a vision to bring authentic dum biryanis, slow-cooked makhani curries, wood-fired artisan pizzas, and street chaats directly to food lovers, Foodly Kitchen blends heirloom family recipes with modern cloud kitchen hygiene standards.
        </p>
        <div class="d-flex gap-3 mt-4">
            <a href="@Url.Action("Index", "Menu")" class="btn btn-warning text-white rounded-pill px-4 py-2 font-weight-bold shadow-sm">
                <i class="fa-solid fa-utensils me-2"></i> Explore Menu
            </a>
            <a href="@Url.Action("Contact", "Home")" class="btn btn-outline-dark rounded-pill px-4 py-2 font-weight-bold">
                Contact Kitchen Desk
            </a>
        </div>
    </div>
    <div class="col-lg-6">
        <img src="https://images.unsplash.com/photo-1588166524941-3bf61a9c41db?w=600&auto=format&fit=crop&q=80"
             alt="Butter Chicken with Naan"
             class="img-fluid rounded-4 shadow-lg border"
             style="max-height: 400px; width: 100%; object-fit: cover;" />
    </div>
</div>

<div class="row g-4 my-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white h-100">
            <div class="foodly-brand-icon mx-auto mb-3">
                <i class="fa-solid fa-award"></i>
            </div>
            <h5 class="font-weight-bold">Handcrafted Spices</h5>
            <p class="text-muted small mb-0">Every garam masala blend and makhani base is ground in-house daily for unmatched aroma and depth.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white h-100">
            <div class="foodly-brand-icon mx-auto mb-3">
                <i class="fa-solid fa-temperature-arrow-up"></i>
            </div>
            <h5 class="font-weight-bold">Piping Hot Dispatch</h5>
            <p class="text-muted small mb-0">Our 30-minute delivery fleet uses high-grade thermal bags to ensure your feast arrives kitchen-hot.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-white h-100">
            <div class="foodly-brand-icon mx-auto mb-3">
                <i class="fa-solid fa-heart-circle-check"></i>
            </div>
            <h5 class="font-weight-bold">FSSAI Certified Safety</h5>
            <p class="text-muted small mb-0">Daily temperature screening, RO-purified cooking water, and 100% contactless preparation.</p>
        </div>
    </div>
</div>