@model FoodDeliveryApp.Models.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "Create an Account";
}

<div class="row justify-content-center my-4">
    <div class="col-lg-6 col-md-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <div class="foodly-brand-icon mx-auto mb-3">
                    <i class="fa-solid fa-user-plus"></i>
                </div>
                <h3 class="font-weight-bold">Join Foodly Kitchen</h3>
                <p class="text-muted small">Sign up to enjoy hot express deliveries, track past orders, and save your addresses.</p>
            </div>

            @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.FullName, new { @class = "form-label font-weight-bold small text-secondary" })
                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control rounded-3", placeholder = "Enter your full name" })
                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label font-weight-bold small text-secondary" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control rounded-3", type = "email", placeholder = "name@example.in" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label font-weight-bold small text-secondary" })
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control rounded-3", placeholder = "Min 6 characters" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-md-6 mb-3">
                        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "form-label font-weight-bold small text-secondary" })
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control rounded-3", placeholder = "Repeat password" })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label font-weight-bold small text-secondary" })
                    <div class="input-group">
                        <span class="input-group-text bg-light">+91</span>
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control rounded-end-3", placeholder = "10-digit Indian mobile number" })
                    </div>
                    @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-4">
                    @Html.LabelFor(m => m.Address, new { @class = "form-label font-weight-bold small text-secondary" })
                    @Html.TextAreaFor(m => m.Address, new { @class = "form-control rounded-3", rows = "2", placeholder = "House/Flat number, Street, Landmark, City & PIN code" })
                    @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small" })
                </div>

                <button type="submit" class="btn btn-warning text-white rounded-pill w-100 py-2 font-weight-bold shadow-sm">
                    Create My Account
                </button>
            }

            <div class="text-center mt-4 pt-3 border-top">
                <span class="text-muted small">Already have an account?</span>
                <a href="@Url.Action("Login", "Account")" class="text-warning font-weight-bold small ms-1">Sign In</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
