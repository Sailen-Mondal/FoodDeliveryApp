@model FoodDeliveryApp.Models.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Administrator Sign In";
}

<div class="row justify-content-center my-4">
    <div class="col-lg-5 col-md-7">
        <div class="card border-0 shadow rounded-4 p-4 p-md-5 bg-white">
            <div class="text-center mb-4">
                <div class="foodly-brand-icon mx-auto mb-3" style="background: linear-gradient(135deg, #1e293b, #0f172a);">
                    <i class="fa-solid fa-shield-halved text-warning"></i>
                </div>
                <h3 class="font-weight-bold">Administrator Portal</h3>
                <p class="text-muted small">Sign in to monitor real-time order requests, auto-rejections, and product availability.</p>
                <div class="badge bg-warning text-dark px-3 py-2 rounded-pill small">
                    <i class="fa-solid fa-key me-1"></i> Kitchen Staff &amp; Store Management Only
                </div>
            </div>

            @using (Html.BeginForm("AdminLogin", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { role = "form" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ReturnUrl)
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

                <div class="mb-3">
                    @Html.LabelFor(m => m.Email, new { @class = "form-label font-weight-bold small text-secondary" })
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control rounded-3", type = "email", placeholder = "admin@foodly.in", autofocus = "autofocus" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Password, new { @class = "form-label font-weight-bold small text-secondary" })
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control rounded-3", placeholder = "Enter admin password" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                </div>

                <div class="form-check mb-4">
                    @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                    @Html.LabelFor(m => m.RememberMe, new { @class = "form-check-label small text-muted" })
                </div>

                <button type="submit" class="btn btn-dark text-white rounded-pill w-100 py-2 font-weight-bold shadow-sm">
                    <i class="fa-solid fa-lock-open me-2 text-warning"></i> Access Order Dashboard
                </button>
            }

            <div class="text-center mt-4 pt-3 border-top">
                <span class="text-muted small">Not an administrator?</span>
                <a href="@Url.Action("Login", "Account")" class="text-warning font-weight-bold small ms-1">Customer Sign In</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
